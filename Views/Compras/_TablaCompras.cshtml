@model List<ZeltekWeb.Models.CompraListViewModel>

@if (Model == null || !Model.Any())
{
    <div class="p-12 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 mb-4">
            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
        </div>
        <h3 class="text-lg font-medium text-slate-800 mb-1">No hay compras encontradas</h3>
        <p class="text-slate-400 text-sm">Prueba ajustando los filtros o registra una nueva compra.</p>
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-xs text-slate-500 uppercase border-b border-slate-200 bg-slate-50">
                    <th class="px-6 py-4 font-medium tracking-wider">ID / Fecha</th>
                    <th class="px-6 py-4 font-medium tracking-wider">Tienda / Producto</th>
                    <th class="px-6 py-4 font-medium tracking-wider">Tracking</th>
                    <th class="px-6 py-4 font-medium tracking-wider text-right">Total</th>
                    <th class="px-6 py-4 font-medium tracking-wider text-center">Estado</th>
                    <th class="px-6 py-4 font-medium tracking-wider text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model)
                {
                    <tr class="group hover:bg-slate-50 transition-colors">
                        <!-- ID / FECHA -->
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex flex-col">
                                <span class="text-slate-800 font-mono font-medium">#@item.CompraID</span>
                                <span class="text-xs text-slate-400">@item.Fecha.ToString("dd MMM yyyy")</span>
                            </div>
                        </td>

                        <!-- TIENDA / PRODUCTO -->
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center text-blue-600 font-bold text-sm shrink-0 uppercase">
                                    @(string.IsNullOrEmpty(item.Vendedor) ? "?" : item.Vendedor.Substring(0, 1))
                                </div>
                                <div>
                                    <div class="text-slate-800 font-medium text-sm">@item.Vendedor</div>
                                    <div class="text-xs text-slate-500 mt-0.5">@item.ProductoPrincipal <span class="text-slate-400">•</span> @item.CantidadItems items</div>
                                </div>
                            </div>
                        </td>

                        <!-- TRACKING -->
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (string.IsNullOrEmpty(item.Tracking) || item.Tracking == "-")
                            {
                                <span class="text-slate-400 text-sm italic">Sin tracking</span>
                            }
                            else
                            {
                                <a href="https://t.17track.net/en#nums=@item.Tracking" target="_blank" class="inline-flex items-center gap-1.5 text-indigo-600 hover:text-indigo-700 transition-colors bg-blue-500/10 hover:bg-indigo-700/20 px-2.5 py-1 rounded text-xs font-mono">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                    @item.Tracking
                                </a>
                            }
                        </td>

                        <!-- TOTAL -->
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <span class="text-emerald-600 font-mono font-medium">$@item.Total.ToString("N2")</span>
                        </td>

                        <!-- ESTADO -->
                        <td class="px-6 py-4 whitespace-nowrap text-center">
                            @{
                                var statusColor = "bg-gray-500/10 text-slate-500 border-gray-500/20";
                                var statusText = item.Estado;
                                
                                if (statusText == "En Transito" || statusText == "En Transito USA") { statusColor = "bg-blue-500/10 text-blue-600 border-blue-500/20"; }
                                else if (statusText == "En Miami") { statusColor = "bg-indigo-500/10 text-indigo-600 border-indigo-500/20"; }
                                else if (statusText == "Viajando a NIC") { statusColor = "bg-purple-500/10 text-purple-600 border-purple-500/20"; }
                                else if (statusText == "En Aduana") { statusColor = "bg-orange-500/10 text-orange-600 border-orange-500/20"; }
                                else if (statusText == "Recibido" || statusText == "Completado") { statusColor = "bg-emerald-500/10 text-emerald-600 border-emerald-500/20"; }
                                else if (statusText == "Cancelado") { statusColor = "bg-red-500/10 text-red-600 border-red-500/20"; }
                            }
                            <span class="px-2.5 py-1 rounded-full text-xs font-medium border @statusColor inline-block min-w-[90px]">
                                @statusText
                            </span>
                            @if(item.ItemsPendientes > 0 && (statusText != "Recibido" && statusText != "Completado"))
                            {
                                <div class="text-[10px] text-orange-600 mt-1">@item.ItemsPendientes pendientes</div>
                            }
                        </td>

                        <!-- ACCIONES -->
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <div class="flex justify-end items-center gap-2">
                                <!-- Ver Detalles -->
                                <a asp-action="Details" asp-route-id="@item.CompraID" 
                                   class="text-slate-500 hover:text-slate-900 p-2 hover:bg-slate-100 rounded-lg transition-all" title="Ver Detalles">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                </a>

                                <!-- Editar Compra -->
                                <a asp-action="Edit" asp-route-id="@item.CompraID"
                                   class="text-slate-500 hover:text-blue-600 p-2 hover:bg-indigo-700/10 rounded-lg transition-all" title="Editar Compra">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                </a>
                                
                                <!-- Recepción Rápida (Forzar Cierre) -->
                                @if (item.Estado != "Completado" && item.Estado != "Recibido" && item.Estado != "Cancelado")
                                {
                                    <form asp-action="ForzarCierre" asp-route-id="@item.CompraID" method="post" 
                                          onsubmit="return confirm('¿Confirmar recepción rápida / cierre forzado? Se marcará como COMPLETADO.');" 
                                          class="inline-block">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-slate-500 hover:text-emerald-600 p-2 hover:bg-emerald-500/10 rounded-lg transition-all" title="Recepción Rápida / Completar">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                        </button>
                                    </form>
                                }

                                <!-- Eliminar / Cancelar -->
                                @if (item.Estado == "En Transito" || item.Estado == "Pagado" || item.Estado == "Pendiente")
                                {
                                    <form asp-action="Eliminar" asp-route-id="@item.CompraID" method="post"
                                          onsubmit="return confirm('¿Estás seguro de cancelar y eliminar esta compra? Esta acción no se puede deshacer.');"
                                          class="inline-block">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-slate-500 hover:text-red-600 p-2 hover:bg-red-500/10 rounded-lg transition-all" title="Cancelar / Eliminar Compra">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}