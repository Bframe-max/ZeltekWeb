@model ZeltekWeb.Models.CompraCreateViewModel
@{
    ViewData["Title"] = "Actualizar Seguimiento";
    string estado = ViewBag.EstadoActual as string;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card bg-card border-0 shadow-lg mt-5">
            <div class="card-header bg-transparent border-bottom border-secondary py-3">
                <h5 class="text-white fw-bold mb-0">✈️ Actualizar Estado del Pedido</h5>
            </div>
            <div class="card-body p-4">

                <form asp-action="Edit" method="post">
                    <input type="hidden" name="id" value="@ViewBag.CompraID" />

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold">Tracking Number (USA)</label>
                        <input type="text" name="tracking" class="form-control bg-dark text-white border-secondary"
                               value="@Model.TrackingProveedor" placeholder="Ej: TBA..." />
                        <div class="form-text text-muted">Ingrésalo cuando el vendedor te lo envíe.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold">Estado Actual</label>
                        <select name="estado" class="form-select bg-dark text-white border-secondary">
                            <!option value="Pagado" @(estado == "Pagado" ? "selected" : "")>💸 1. Pagado (Esperando envío)</!option>
                            <!option value="En Transito USA" @(estado == "En Transito USA" ? "selected" : "")>🇺🇸 2. En Tránsito (Dentro USA)</!option>
                            <!option value="En Miami" @(estado == "En Miami" ? "selected" : "")>🏢 3. Recibido en Miami</!option>
                            <!option value="Viajando a NIC" @(estado == "Viajando a NIC" ? "selected" : "")>✈️/🚢 4. Viajando a Nicaragua</!option>
                            <!option value="En Aduana" @(estado == "En Aduana" ? "selected" : "")>👮‍♂️ 5. En Aduana Managua</!option>
                            <!option value="Recibido" @(estado == "Recibido" ? "selected" : "")>✅ 6. Recibido Final</!option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-bold">💾 Actualizar Estado</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>