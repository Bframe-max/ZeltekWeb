@model List<ZeltekWeb.Models.CompraListViewModel>

@{
    ViewData["Title"] = "Mis Compras";

    // DEFINIMOS LOS ESTADOS ACTIVOS
    var estadosPendientes = new[] { "En Transito", "Pagado", "En Transito USA", "En Miami", "Viajando a NIC", "En Aduana" };

    // SEPARAMOS LAS LISTAS AQUÍ MISMO
    var listaActiva = Model.Where(x => estadosPendientes.Contains(x.Estado) && x.Estado != "Recibido").ToList();
    var listaHistorial = Model.Where(x => !estadosPendientes.Contains(x.Estado) || x.Estado == "Recibido").ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-white">🛒 Compras e Importaciones</h2>
    <a asp-controller="Compras" asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Nueva Compra
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card bg-card border-start border-4 border-info">
            <div class="card-body">
                <small class="text-secondary text-uppercase fw-bold">Pedidos Activos</small>
                <h3 class="text-white fw-bold mb-0">@listaActiva.Count</h3>
                <small class="text-info">En proceso de importación</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-card border-start border-4 border-warning">
            <div class="card-body">
                <small class="text-secondary text-uppercase fw-bold">Inversión Flotante (Riesgo)</small>
                <h3 class="text-warning fw-bold mb-0">$@listaActiva.Sum(x => x.Total).ToString("N2")</h3>
                <small class="text-secondary">Dinero pendiente de llegar</small>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4 bg-card border-0">
    <div class="card-body py-3">
        <form method="get" action="/Compras/Index" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-secondary" style="border-color: var(--border-color);">🔍</span>
                    <input type="text" name="buscar" class="form-control border-start-0 text-white bg-dark"
                           placeholder="Buscar por Tienda, Tracking o Estado..."
                           value="@ViewData["BusquedaActual"]">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Buscar</button>
            </div>
        </form>
    </div>
</div>

<ul class="nav nav-tabs border-bottom-0 mb-3" id="comprasTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-4" id="activos-tab" data-bs-toggle="tab" data-bs-target="#activos" type="button" role="tab">
            ✈️ En Tránsito <span class="badge bg-info text-dark ms-2">@listaActiva.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 text-secondary" id="historial-tab" data-bs-toggle="tab" data-bs-target="#historial" type="button" role="tab">
            ✅ Historial Completado
        </button>
    </li>
</ul>

<div class="tab-content" id="comprasTabsContent">

    <div class="tab-pane fade show active" id="activos" role="tabpanel">
        <div class="card bg-card border-0 border-top border-4 border-info">
            <div class="card-body p-0">
                @await Html.PartialAsync("_TablaCompras", listaActiva)
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="historial" role="tabpanel">
        <div class="card bg-card border-0">
            <div class="card-body p-0">
                @await Html.PartialAsync("_TablaCompras", listaHistorial)
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #8a8a9e;
        border: none;
        background: transparent;
        border-bottom: 3px solid transparent;
    }

        .nav-tabs .nav-link:hover {
            color: #fff;
        }

        .nav-tabs .nav-link.active {
            background-color: transparent !important;
            color: #fff !important;
            border-bottom: 3px solid #0dcaf0 !important;
        }
</style>