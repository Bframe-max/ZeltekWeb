@model ZeltekWeb.Models.CompraCreateViewModel

@{
    ViewData["Title"] = "Nueva Compra";
}

<style>
    /* Custom styles for smoother dark theme inputs */
    .form-control:focus, .form-select:focus {
        background-color: #2b3035 !important; /* Slightly lighter dark */
        color: #fff !important;
        border-color: #0d6efd; /* Bootstrap primary blue */
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    .btn-hover-effect:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        transition: all 0.2s ease-in-out;
    }

    .card-modern {
        border-radius: 12px;
        overflow: hidden;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7"> <!-- Increased width slightly for better spacing -->
        <div class="card bg-card border-0 shadow-lg mt-4 card-modern">
            <div class="card-header bg-transparent border-bottom border-secondary py-3">
                <h4 class="text-white fw-bold mb-0">🛒 Registrar Compra eBay</h4>
            </div>
            <div class="card-body p-4 p-md-5">

                <form id="formRegistrarCompra" asp-action="Create" method="post">
                    <!-- Validation Summary: Hidden by default, only shows if errors exist -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger small rounded-3 mb-4" role="alert"></div>
                    }

                    <!-- Row 1: Vendedor & Tracking -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Vendedor" class="form-label text-light fw-bold small">Vendedor</label>
                            <input asp-for="Vendedor" class="form-control bg-dark text-white border-secondary rounded-3 py-2" placeholder="Ej: eBay: techsale78" />
                            <span asp-validation-for="Vendedor" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TrackingProveedor" class="form-label text-light fw-bold small">Tracking <span class="text-white-50 fw-normal">(opcional)</span></label>
                            <input asp-for="TrackingProveedor" id="Tracking" class="form-control bg-dark text-white border-secondary rounded-3 py-2" placeholder="Ej: 1Z999..." autocomplete="off" />
                            <span asp-validation-for="TrackingProveedor" class="text-danger small"></span>
                            <small id="mensajeTracking" class="d-none mt-1 small"></small>
                        </div>
                    </div>

                    <!-- Row 2: Fecha -->
                    <div class="mb-4">
                         <label asp-for="FechaCompra" class="form-label text-light fw-bold small">Fecha</label>
                        <input asp-for="FechaCompra" type="date" class="form-control bg-dark text-white border-secondary rounded-3 py-2" />
                         <span asp-validation-for="FechaCompra" class="text-danger small"></span>
                    </div>
                    
                    <!-- Row 3: Producto -->
                    <div class="mb-4">
                        <label asp-for="ProductoID" class="form-label text-light fw-bold small">Producto</label>
                        <select asp-for="ProductoID" asp-items="ViewBag.Productos" class="form-select bg-dark text-white border-secondary rounded-3 py-2 select2-producto" style="width: 100%;">
                            <option value="">-- Selecciona un producto --</option>
                        </select>
                        <span asp-validation-for="ProductoID" class="text-danger small"></span>
                    </div>

                    <hr class="border-secondary my-4 opacity-25" />

                    <!-- Row 4: Financials -->
                    <div class="row g-3 mb-2">
                        <div class="col-md-4">
                            <label asp-for="Cantidad" class="form-label text-light fw-bold small">Cantidad</label>
                            <input asp-for="Cantidad" type="number" id="Cantidad" class="form-control bg-dark text-white border-secondary rounded-3 py-2" min="1" value="1" />
                            <span asp-validation-for="Cantidad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CostoTotalCompra" class="form-label text-light fw-bold small">Costo Total Compra ($)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">$</span>
                                <input asp-for="CostoTotalCompra" type="number" step="0.01" id="CostoTotalCompra" class="form-control bg-dark text-white border-secondary rounded-3 py-2" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="CostoTotalCompra" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CostoEnvioTotal" class="form-label text-light fw-bold small">Costo Envío Total ($)</label>
                             <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">$</span>
                                <input asp-for="CostoEnvioTotal" type="number" step="0.01" id="CostoEnvioTotal" class="form-control bg-dark text-white border-secondary rounded-3 py-2" value="0" placeholder="0.00" />
                            </div>
                             <span asp-validation-for="CostoEnvioTotal" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Calculated Unit Cost -->
                    <div class="mb-5 text-end">
                         <div class="p-2 d-inline-block rounded-3 bg-dark bg-opacity-25 border border-secondary border-opacity-25">
                            <small class="text-muted d-block text-start mb-1" style="font-size: 0.8rem;">Cálculo automático:</small>
                            <span id="costoUnitarioCalculado" class="text-success fs-5 fw-bold d-block">
                                Costo unitario: $0.00
                            </span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-grid gap-3 d-md-flex justify-content-md-end">
                        <a asp-controller="Inventario" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">Cancelar</a>
                        <button type="button" class="btn btn-primary fw-bold px-5 py-2 rounded-3 btn-hover-effect" id="btnGuardarCompra">
                             💾 Guardar Compra
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('formRegistrarCompra');
            var inputTracking = document.getElementById('Tracking');
            var mensajeTracking = document.getElementById('mensajeTracking');

            // Botón Guardar: Logic
            var btnGuardar = document.getElementById('btnGuardarCompra');
            if (btnGuardar && form) {
                btnGuardar.addEventListener('click', function () {
                    try {
                        // Validación explícita con jQuery Validate
                        var $form = $('#formRegistrarCompra');
                        if ($form.length && typeof $form.valid === 'function') {
                            if (!$form.valid()) {
                                return;
                            }
                        }

                        // Comprobación manual de campos críticos
                        var inputCantidad = document.getElementById('Cantidad');
                        var inputCostoTotalCompra = document.getElementById('CostoTotalCompra');
                        
                        var cantidad = parseInt(inputCantidad.value, 10) || 0;
                        var costoTotal = parseFloat(inputCostoTotalCompra.value) || 0;

                        if (cantidad <= 0 || costoTotal <= 0) {
                            alert('Por favor valida que Cantidad y Costo Total sean mayores a 0.');
                            return;
                        }

                        // Submit
                        form.submit();

                    } catch (error) {
                        console.error(error);
                        alert('Ocurrió un error al procesar el formulario.');
                    }
                });
            }

            // Actualizar costo unitario calculado (Total / Cantidad)
            function actualizarCostoUnitario() {
                var el = document.getElementById('costoUnitarioCalculado');
                if (!el) return;
                var cantidad = parseInt(document.getElementById('Cantidad').value, 10) || 0;
                var total = parseFloat(document.getElementById('CostoTotalCompra').value) || 0;
                
                if (cantidad <= 0) {
                    el.textContent = 'Costo unitario: $0.00';
                    return;
                }
                var unitario = total / cantidad;
                el.textContent = 'Costo unitario: $' + unitario.toFixed(2);
            }

            var cant = document.getElementById('Cantidad');
            var costoT = document.getElementById('CostoTotalCompra');
            if (cant) { cant.addEventListener('input', actualizarCostoUnitario); cant.addEventListener('change', actualizarCostoUnitario); }
            if (costoT) { costoT.addEventListener('input', actualizarCostoUnitario); costoT.addEventListener('change', actualizarCostoUnitario); }
            actualizarCostoUnitario();

            // Tracking Logic
             function mostrarEstado(existe) {
                if (!mensajeTracking || !inputTracking) return;
                
                mensajeTracking.classList.remove('d-none', 'text-danger', 'text-success');
                inputTracking.classList.remove('border-danger', 'border-success');

                if (existe === true) {
                    mensajeTracking.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Este tracking ya fue registrado.';
                    mensajeTracking.classList.add('d-block', 'text-danger');
                    inputTracking.classList.add('border-danger');
                } else {
                    mensajeTracking.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Tracking válido (nuevo)';
                    mensajeTracking.classList.add('d-block', 'text-success');
                    inputTracking.classList.add('border-success');
                }
            }

            function limpiarEstado() {
                if (mensajeTracking) {
                    mensajeTracking.textContent = '';
                    mensajeTracking.classList.add('d-none');
                    mensajeTracking.classList.remove('d-block');
                }
                if (inputTracking) {
                    inputTracking.classList.remove('border-danger', 'border-success');
                }
            }

            if (inputTracking) {
                inputTracking.addEventListener('blur', function () {
                    var t = (inputTracking.value || '').trim();
                    if (t === '') {
                        limpiarEstado();
                        return;
                    }
                    // Simple debounce/check logic
                    fetch('/Compras/VerificarTracking?tracking=' + encodeURIComponent(t))
                        .then(function (r) { return r.json(); })
                        .then(function (existe) {
                            mostrarEstado(existe);
                        })
                        .catch(function () { limpiarEstado(); });
                });
                inputTracking.addEventListener('input', function () {
                    var t = (inputTracking.value || '').trim();
                    if (t === '') limpiarEstado();
                });
            }
        })();
    </script>
}