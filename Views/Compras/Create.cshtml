@model ZeltekWeb.Models.CompraViewModel

<h2>🆕 Nueva Compra</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">Proveedor</label>
        <select asp-for="ProveedorID"
                asp-items="ViewBag.Proveedores"
                class="form-select">
            <option value="">-- Seleccione proveedor --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Vendedor Online</label>
        <input asp-for="VendedorOnline" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de Compra</label>
        <input asp-for="FechaCompra" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tracking</label>
        <input asp-for="TrackingProveedor" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Guardar</button>
    <a href="/Compras" class="btn btn-secondary">Cancelar</a>
</form>
