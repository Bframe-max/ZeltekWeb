@model ZeltekWeb.Models.CompraCreateViewModel

@{
    ViewData["Title"] = "Nueva Compra";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card bg-card border-0 shadow-lg mt-4">
            <div class="card-header bg-transparent border-bottom border-secondary py-3">
                <h4 class="text-white fw-bold mb-0">🛒 Registrar Compra eBay</h4>
            </div>
            <div class="card-body p-4">

                <form id="formRegistrarCompra" asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger small" id="validationSummary" role="alert"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Vendedor</label>
                            <input asp-for="Vendedor" class="form-control bg-dark text-white border-secondary" placeholder="Ej: eBay: techsale78" />
                            <span asp-validation-for="Vendedor" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Tracking <span class="text-muted fw-normal">(opcional)</span></label>
                            <input asp-for="TrackingProveedor" id="Tracking" class="form-control bg-dark text-white border-secondary" placeholder="Ej: 1Z999..." autocomplete="off" />
                            <span asp-validation-for="TrackingProveedor" class="text-danger small"></span>
                            <small id="mensajeTracking" class="d-block mt-1 small" style="display: none;"></small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold">Fecha</label>
                        <input asp-for="FechaCompra" type="date" class="form-control bg-dark text-white border-secondary" />
                    </div>

                    <hr class="border-secondary my-4" />

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Producto</label>
                        <select asp-for="ProductoID" asp-items="ViewBag.Productos" class="form-select bg-dark text-white border-secondary select2-producto" style="width: 100%;">
                            <option value="">-- Selecciona --</option>
                        </select>
                        <span asp-validation-for="ProductoID" class="text-danger small"></span>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label text-secondary small fw-bold">Cantidad</label>
                            <input asp-for="Cantidad" type="number" id="Cantidad" class="form-control bg-dark text-white border-secondary" min="1" value="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-secondary small fw-bold">Costo Total Compra ($)</label>
                            <input asp-for="CostoTotalCompra" type="number" step="0.01" id="CostoTotalCompra" class="form-control bg-dark text-white border-secondary" placeholder="Ej: 200" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-secondary small fw-bold">Costo Envío Total ($) <span class="text-muted fw-normal">(opcional)</span></label>
                            <input asp-for="CostoEnvioTotal" type="number" step="0.01" id="CostoEnvioTotal" class="form-control bg-dark text-white border-secondary" value="0" placeholder="0" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <small id="costoUnitarioCalculado" class="text-muted">Costo unitario calculado: $0.00</small>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary fw-bold py-2" id="btnGuardarCompra">💾 Guardar Compra</button>
                        <a asp-controller="Inventario" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('formRegistrarCompra');
            var inputTracking = document.getElementById('Tracking');
            var mensajeTracking = document.getElementById('mensajeTracking');

            // Botón Guardar: type="button" para evitar submit y recarga. Envío por AJAX.
            var btnGuardar = document.getElementById('btnGuardarCompra');
            if (btnGuardar && form) {
                btnGuardar.addEventListener('click', function () {
                    console.log('Botón presionado. Iniciando validación...');
                    try {
                        // Validación explícita con jQuery Validate (si está cargado)
                        var $form = $('#formRegistrarCompra');
                        if ($form.length && typeof $form.valid === 'function') {
                            if (!$form.valid()) {
                                var validator = $form.validate();
                                var errorList = validator.errorList || [];
                                var mensajes = [];
                                for (var i = 0; i < errorList.length; i++) {
                                    var err = errorList[i];
                                    var el = err.element;
                                    var name = (el && (el.name || el.id)) || ('Campo #' + (i + 1));
                                    var msg = err.message || 'no válido';
                                    var tipo = (el && el.type) ? String(el.type).toLowerCase() : '';
                                    mensajes.push('• ' + name + ': ' + msg);
                                    console.warn('El campo "' + name + '" es inválido porque: ' + msg);
                                    if (tipo === 'hidden') {
                                        console.warn('⚠️ El campo con error es type="hidden" (nombre/id: ' + name + '). Considera eliminarlo del HTML o del Modelo si ya no se usa (ej. CostoUnitario).');
                                    }
                                }
                                var texto = mensajes.length ? mensajes.join('\n') : 'Hay errores de validación. Revisa el formulario.';
                                alert('Faltan o son incorrectos los siguientes campos:\n\n' + texto);
                                return;
                            }
                        }

                        // Comprobación manual de campos clave (por si jQuery Validate no está)
                        var inputCantidad = document.getElementById('Cantidad');
                        var inputCostoTotalCompra = document.getElementById('CostoTotalCompra');
                        var inputCostoEnvioTotal = document.getElementById('CostoEnvioTotal');
                        if (!inputCantidad || !inputCostoTotalCompra || !inputCostoEnvioTotal) {
                            alert('Error JS: No se encontraron los inputs (Cantidad, CostoTotalCompra, CostoEnvioTotal).');
                            return;
                        }
                        var cantidad = parseInt(inputCantidad.value, 10) || 0;
                        var costoTotal = parseFloat(inputCostoTotalCompra.value) || 0;
                        var costoEnvio = parseFloat(inputCostoEnvioTotal.value) || 0;

                        if (cantidad <= 0 || costoTotal <= 0) {
                            alert('Por favor ingresa Cantidad y Costo Total Compra mayores a 0.');
                            return;
                        }

                        var datosCompra = {
                            Cantidad: cantidad,
                            CostoTotalLote: costoTotal,
                            CostoEnvioTotal: costoEnvio,
                            ProductoID: (document.querySelector('select[name="ProductoID"]') || {}).value || '',
                            Vendedor: (document.querySelector('input[name="Vendedor"]') || {}).value || '',
                            TrackingProveedor: (document.querySelector('input[name="TrackingProveedor"]') || {}).value || '',
                            FechaCompra: (document.querySelector('input[name="FechaCompra"]') || {}).value || ''
                        };
                        console.log('Enviando compra (Submit estándar)...', datosCompra);

                        // En lugar de fetch, usamos submit estándar para que el servidor
                        // pueda retornar la Vista con errores de validación si existen.
                        form.submit();

                    } catch (error) {
                        alert('Error JS: ' + (error && error.message ? error.message : String(error)));
                        console.error(error);
                    }
                });
            }

            // Actualizar costo unitario calculado (Total / Cantidad)
            function actualizarCostoUnitario() {
                var el = document.getElementById('costoUnitarioCalculado');
                if (!el) return;
                var cantidad = parseInt(document.getElementById('Cantidad').value, 10) || 0;
                var total = parseFloat(document.getElementById('CostoTotalCompra').value) || 0;
                if (cantidad <= 0) {
                    el.textContent = 'Costo unitario calculado: $0.00';
                    return;
                }
                var unitario = total / cantidad;
                el.textContent = 'Costo unitario calculado: $' + unitario.toFixed(2);
            }
            var cant = document.getElementById('Cantidad');
            var costoT = document.getElementById('CostoTotalCompra');
            if (cant) { cant.addEventListener('input', actualizarCostoUnitario); cant.addEventListener('change', actualizarCostoUnitario); }
            if (costoT) { costoT.addEventListener('input', actualizarCostoUnitario); costoT.addEventListener('change', actualizarCostoUnitario); }
            actualizarCostoUnitario();

            function mostrarEstado(existe) {
                if (!mensajeTracking || !inputTracking) return;
                if (existe === true) {
                    mensajeTracking.textContent = '⛔ Este tracking ya fue registrado.';
                    mensajeTracking.className = 'd-block mt-1 small text-danger';
                    mensajeTracking.style.display = 'block';
                    inputTracking.classList.add('border', 'border-danger');
                    // No deshabilitar el botón: el servidor validará y mostrará el error al enviar
                } else {
                    mensajeTracking.textContent = '✅ Tracking válido';
                    mensajeTracking.className = 'd-block mt-1 small text-success';
                    mensajeTracking.style.display = 'block';
                    inputTracking.classList.remove('border', 'border-danger');
                }
            }

            function limpiarEstado() {
                if (mensajeTracking) {
                    mensajeTracking.textContent = '';
                    mensajeTracking.style.display = 'none';
                }
                if (inputTracking) inputTracking.classList.remove('border', 'border-danger');
            }

            if (inputTracking) {
                inputTracking.addEventListener('blur', function () {
                    var t = (inputTracking.value || '').trim();
                    if (t === '') {
                        limpiarEstado();
                        return;
                    }
                    fetch('/Compras/VerificarTracking?tracking=' + encodeURIComponent(t))
                        .then(function (r) { return r.json(); })
                        .then(function (existe) {
                            mostrarEstado(existe);
                        })
                        .catch(function () { limpiarEstado(); });
                });
                inputTracking.addEventListener('input', function () {
                    var t = (inputTracking.value || '').trim();
                    if (t === '') limpiarEstado();
                });
            }
        })();
    </script>
}