@model List<ZeltekWeb.Models.InventarioViewModel>

@{
    ViewData["Title"] = "Inventario";

    // Separamos los datos en 3 listas aquí mismo
    var enStock = Model.Where(x => x.Estado != "En Camino" && x.Estado != "Vendido").ToList();
    var enCamino = Model.Where(x => x.Estado == "En Camino").ToList();
    var vendidos = Model.Where(x => x.Estado == "Vendido").ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-white">📦 Gestión de Inventario</h2>
</div>

<div class="card mb-4 bg-card border-0">
    <div class="card-body py-3">
        <form method="get" action="/Inventario/Index" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-secondary" style="border-color: var(--border-color);">🔍</span>
                    <input type="text" name="buscar" class="form-control border-start-0"
                           placeholder="Buscar por Serie, Producto..."
                           value="@ViewData["BusquedaActual"]">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Buscar</button>
            </div>
        </form>
    </div>
</div>

<ul class="nav nav-tabs border-bottom-0 mb-3" id="inventoryTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-4" id="stock-tab" data-bs-toggle="tab" data-bs-target="#stock" type="button" role="tab">
            📦 En Bodega <span class="badge bg-primary ms-2">@enStock.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 text-info" id="camino-tab" data-bs-toggle="tab" data-bs-target="#camino" type="button" role="tab">
            ✈️ En Tránsito <span class="badge bg-info text-dark ms-2">@enCamino.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 text-secondary" id="vendidos-tab" data-bs-toggle="tab" data-bs-target="#vendidos" type="button" role="tab">
            🔴 Historial Vendidos
        </button>
    </li>
</ul>

<div class="tab-content" id="inventoryTabsContent">

    <div class="tab-pane fade show active" id="stock" role="tabpanel">
        <div class="card bg-card border-0">
            <div class="card-body p-0">
                @await Html.PartialAsync("_TablaInventario", enStock)
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="camino" role="tabpanel">
        <div class="card bg-card border-0 border-top border-4 border-info">
            <div class="card-body p-0">
                @await Html.PartialAsync("_TablaInventario", enCamino)
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="vendidos" role="tabpanel">
        <div class="card bg-card border-0">
            <div class="card-body p-0">
                @await Html.PartialAsync("_TablaInventario", vendidos)
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #8a8a9e;
        border: none;
        background: transparent;
        border-bottom: 3px solid transparent;
    }

        .nav-tabs .nav-link:hover {
            color: #fff;
            border-color: transparent;
        }

        .nav-tabs .nav-link.active {
            background-color: transparent !important;
            color: #fff !important;
            border-bottom: 3px solid #5646ff !important; /* Línea morada activa */
        }
    /* El tab de tránsito activo se pone azulito */
    #camino-tab.active {
        border-bottom: 3px solid #0dcaf0 !important;
        color: #0dcaf0 !important;
    }
</style>