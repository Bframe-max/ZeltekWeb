@model List<ZeltekWeb.Models.ItemEnReparacionViewModel>
@{
    ViewData["Title"] = "Equipos en Reparación";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-white mb-0">🔧 Equipos en Reparación</h2>
        <p class="text-secondary small mb-0">Gestiona los ítems enviados a reparación y finalízalos cuando estén listos.</p>
    </div>
    <a asp-controller="Inventario" asp-action="Index" class="btn btn-outline-secondary">← Volver a Inventario</a>
</div>

<div class="card bg-card border-0 border-start border-4 border-warning">
    <div class="card-header bg-transparent border-bottom border-secondary py-3">
        <h5 class="text-white fw-bold mb-0">Listado</h5>
        <small class="text-secondary">Producto, serie, problema reportado y fecha de ingreso.</small>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="border-bottom: 1px solid var(--border-color);">
                    <tr>
                        <th class="ps-4 text-white">Producto</th>
                        <th class="text-white">Serie</th>
                        <th class="text-white">Problema reportado</th>
                        <th class="text-white">Fecha ingreso</th>
                        <th class="text-end pe-4 text-white">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-white">@item.ProductoNombre</td>
                            <td><span class="badge bg-dark text-info font-monospace">@item.NumeroSerie</span></td>
                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(item.ProblemaReportado) ? "—" : item.ProblemaReportado)</td>
                            <td class="text-secondary">@(item.FechaIngreso?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-sm btn-success"
                                        data-itemid="@item.ItemID"
                                        data-producto="@item.ProductoNombre"
                                        data-serie="@item.NumeroSerie"
                                        onclick="abrirModalFinalizar(this)">
                                    ✅ Finalizar
                                </button>
                                <button type="button" class="btn btn-sm btn-danger ms-1"
                                        data-itemid="@item.ItemID"
                                        data-producto="@item.ProductoNombre"
                                        data-serie="@item.NumeroSerie"
                                        onclick="abrirModalPerdida(this)">
                                    🗑️ Pérdida
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-wrench fs-1 d-block mb-2"></i>
                No hay equipos en reparación. Los ítems enviados desde la inspección de calidad aparecerán aquí.
            </div>
        }
    </div>
</div>

<!-- Modal Finalizar Reparación -->
<div class="modal fade" id="modalFinalizarReparacion" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">✅ Finalizar reparación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form asp-action="FinalizarReparacion" method="post" id="formFinalizarReparacion">
                <input type="hidden" name="itemId" id="finalizarItemId" />
                <div class="modal-body">
                    <p class="text-secondary small mb-3">
                        <strong id="finalizarProducto"></strong> · S/N: <span id="finalizarSerie" class="font-monospace"></span>
                    </p>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Costo repuestos ($)</label>
                            <input type="number" step="0.01" min="0" name="costoRepuestos" id="inputCostoRepuestos" value="0"
                                   class="form-control bg-black text-white border-secondary" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Costo mano de obra ($)</label>
                            <input type="number" step="0.01" min="0" name="costoManoObra" id="inputCostoManoObra" value="0"
                                   class="form-control bg-black text-white border-secondary" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Notas de la reparación</label>
                        <textarea name="notasReparacion" id="inputNotasReparacion" rows="3"
                                  class="form-control bg-black text-white border-secondary"
                                  placeholder="Qué se le hizo al equipo..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary text-white" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold">Guardar y pasar a Stock</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Declarar Pérdida -->
<div class="modal fade" id="modalPerdida" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-danger">
            <div class="modal-header border-danger">
                <h5 class="modal-title fw-bold text-danger">⚠️ Declarar Pérdida Total</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form asp-action="DeclararPerdidaReparacion" method="post">
                <input type="hidden" name="itemId" id="perdidaItemId" />
                <div class="modal-body">
                    <div class="alert alert-danger d-flex align-items-center mb-3">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div>
                            Esta acción marcará el equipo como <strong>Pérdida Total</strong> y registrará un gasto por "Merma/Daño".
                            <br /><br />
                            <strong>Irreversibles:</strong> El ítem saldrá del inventario activo y se cancelará la reparación.
                        </div>
                    </div>
                    
                    <p class="text-secondary small mb-3">
                        Producto: <strong id="perdidaProducto"></strong> <br/>
                        S/N: <span id="perdidaSerie" class="font-monospace"></span>
                    </p>

                    <div class="mb-3">
                        <label class="form-label text-white small fw-bold">Motivo de la pérdida (Obligatorio)</label>
                        <textarea name="motivo" required rows="3" class="form-control bg-black text-white border-danger" placeholder="Ej: Placa base quemada, sin reparación..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-danger">
                    <button type="button" class="btn btn-outline-secondary text-white" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-bold">Confirmar Pérdida</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function abrirModalFinalizar(btn) {
        var id = parseInt(btn.getAttribute('data-itemid'), 10);
        var producto = btn.getAttribute('data-producto') || '';
        var serie = btn.getAttribute('data-serie') || '';
        document.getElementById('finalizarItemId').value = id;
        document.getElementById('finalizarProducto').textContent = producto;
        document.getElementById('finalizarSerie').textContent = serie;
        document.getElementById('inputCostoRepuestos').value = '0';
        document.getElementById('inputCostoManoObra').value = '0';
        document.getElementById('inputNotasReparacion').value = '';
        var modal = new bootstrap.Modal(document.getElementById('modalFinalizarReparacion'));
        modal.show();
    }

    function abrirModalPerdida(btn) {
        var id = parseInt(btn.getAttribute('data-itemid'), 10);
        var producto = btn.getAttribute('data-producto') || '';
        var serie = btn.getAttribute('data-serie') || '';
        
        document.getElementById('perdidaItemId').value = id;
        document.getElementById('perdidaProducto').textContent = producto;
        document.getElementById('perdidaSerie').textContent = serie;
        
        var modal = new bootstrap.Modal(document.getElementById('modalPerdida'));
        modal.show();
    }
</script>
