@model List<ZeltekWeb.Models.InventarioViewModel>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead style="border-bottom: 1px solid var(--border-color);">
            <tr>
                <th class="ps-4 text-white">Producto</th>
                <th class="text-white">Serie</th>
                <th class="text-white">Costo</th>
                <th class="text-white">Venta</th>
                <th class="text-white">Estado</th>
                <th class="text-end pe-4 text-white">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                bool esVendido = i.Estado == "Vendido";
                bool esEnCamino = i.Estado == "En Camino";

                <tr class="@(esVendido ? "opacity-50" : "")">
                    <td class="ps-4">
                        <div class="d-flex flex-column">
                            <span class="fw-bold text-white fs-6">@i.Producto</span>
                            <small class="text-secondary">@i.Especificaciones</small>
                        </div>
                    </td>
                    <td>
                        @if (esEnCamino)
                        {
                            <span class="badge bg-info text-dark">⏳ EN TRÁNSITO</span>
                        }
                        else
                        {
                            <span class="badge bg-dark text-secondary border border-secondary">@i.NumeroSerie</span>
                        }
                    </td>
                    <td class="text-secondary">$@i.CostoCompra</td>
                    <td class="fw-bold text-white">@(i.PrecioVenta > 0 ? "$" + i.PrecioVenta : "—")</td>
                    <td>
                        @if (esVendido)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger">🔴 Vendido</span>
                        }
                        else if (esEnCamino)
                        {

                            <span class="badge bg-info bg-opacity-10 text-info">✈️ En Camino</span>
                        }
                        else
                        {

                            <span class="badge bg-success bg-opacity-10 text-success">🟢 En Stock</span>
                        }
                    </td>
                    <td class="text-end pe-4">
                        @if (esEnCamino)
                        {
                            <button class="btn btn-sm btn-outline-secondary disabled">🕒 Esperando...</button>
                        }
                        else if (!esVendido)
                        {
                            <a class="btn btn-sm btn-success fw-bold" href="/Ventas/Create?itemId=@i.ItemID">💰 Vender</a>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center py-4 text-secondary">Esta lista está vacía.</td></tr>
            }
        </tbody>
    </table>
</div>