<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Zeltek</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Tailwind CSS (No Preflight to avoid Bootstrap conflicts) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        corePlugins: {
          preflight: false,
        },
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
            },
            colors: {
              'card-dark': '#1e1e2d',
              'border-dark': '#2d2d3f',
            }
          }
        }
      }
    </script>
    <style>
        /* Select2 en tema oscuro */
        .select2-container--default .select2-selection--single { background-color: #1b1b29; border-color: var(--border-color); color: #fff; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { color: #fff; }
        .select2-container--default .select2-results__option--highlighted[aria-selected] { background-color: var(--accent-color); }
        .select2-dropdown { background-color: #1e1e2d; border-color: var(--border-color); }
        .select2-container--default .select2-results__option[aria-selected=true] { background-color: #2d2d3f; color: #fff; }
        .select2-search--dropdown .select2-search__field { background: #1b1b29; color: #fff; border-color: var(--border-color); }
    </style>

    <style>
        /* ================= TEMA OSCURO (VARIABLES) ================= */
        :root {
            --bg-body: #1a1b2e;
            --bg-card: #24253b;
            --text-primary: #ffffff;
            --text-secondary: #9ca3af;
            --accent-color: #7c3aed;
            --border-color: #2e2f45;
            --sidebar-width: 280px;
        }

        /* 1. FORZAMOS EL BODY OSCURO */
        body {
            background-color: var(--bg-body) !important;
            color: var(--text-primary) !important;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* 2. ESTRUCTURA (FLEXBOX) */
        #wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
            overflow: hidden;
        }

        /* Sidebar Base */
        #sidebar-wrapper {
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            background: linear-gradient(180deg, #24253b 0%, #1a1b2e 100%) !important;
            border-right: 1px solid var(--border-color);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        /* Contenido Base */
        #page-content-wrapper {
            flex-grow: 1;
            width: 100%;
            min-width: 0;
        }

        /* Overlay para móvil */
        #overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 999;
        }

        /* 3. LÓGICA PC (PANTALLA GRANDE) */
        /* Nota: Usamos @@media porque estamos en un archivo .cshtml */
        @@media (min-width: 769px) {
            #sidebar-wrapper {
                margin-left: 0;
                position: relative; /* Ocupa espacio físico */
            }

            #mobile-toggle, #overlay {
                display: none !important;
            }
        }

        /* 4. LÓGICA MÓVIL (PANTALLA PEQUEÑA) */
        @@media (max-width: 768px) {
            #sidebar-wrapper {
                position: fixed; /* Flota encima */
                top: 0;
                bottom: 0;
                left: -260px; /* Escondido */
                height: 100vh;
                box-shadow: 5px 0 15px rgba(0,0,0,0.5);
            }

                #sidebar-wrapper.show-nav {
                    left: 0; /* Aparece */
                }

            #overlay.show-nav {
                display: block;
            }
        }

        /* ================= CORRECCIÓN DE COLORES (FORCE DARK) ================= */

        /* TARJETAS: Matamos el blanco de Bootstrap con !important */
        .card {
            background-color: var(--bg-card) !important;
            border: 1px solid var(--border-color) !important;
            color: var(--text-primary) !important;
        }

        /* TEXTOS: Forzamos blanco en títulos que Bootstrap pone negros */
        h1, h2, h3, h4, h5, h6, .card-title, .card-text {
            color: var(--text-primary) !important;
        }

        /* NAVBAR: Transparente y textos blancos */
        .navbar {
            background-color: var(--bg-body) !important;
            border-bottom: 1px solid var(--border-color);
        }

        /* ESTILOS DEL MENÚ */
        .list-group-item {
            background: transparent !important;
            color: #9ca3af !important;
            border: none !important;
            padding: 12px 24px;
            margin: 4px 16px;
            border-radius: 12px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

            .list-group-item:hover {
                color: #ffffff !important;
                background-color: rgba(255, 255, 255, 0.05) !important;
            }

            .list-group-item.active {
                background: linear-gradient(90deg, #7c3aed 0%, #3b82f6 100%) !important;
                color: #ffffff !important;
                box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
            }
            
            /* Remove old border-left style */
            .list-group-item.active { border-left: none !important; }

        .sidebar-heading {
            padding: 1.5rem;
            font-size: 1.4rem;
            font-weight: bold;
            color: var(--text-primary) !important;
            border-bottom: 1px solid var(--border-color);
        }
        
        /* SCROLLBAR PERSONALIZADO PARA SIDEBAR */
        #sidebar-wrapper::-webkit-scrollbar { width: 5px; }
        #sidebar-wrapper::-webkit-scrollbar-track { background: transparent; }
        #sidebar-wrapper::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
        #sidebar-wrapper::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
    </style>
</head>

<body>

    <div id="overlay"></div>

    <div id="wrapper">

        <div id="sidebar-wrapper" class="bg-[#24253b] border-r border-white/5 flex flex-col">
            <!-- 1. Brand Section -->
            <div class="p-6 flex items-center gap-3">
                <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-purple-600 to-blue-600 flex items-center justify-center shadow-lg shadow-purple-500/30 shrink-0">
                     <i class="bi bi-rocket-takeoff-fill text-white"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-white tracking-tight leading-none mb-0">Zeltek</h1>
                    <span class="text-[10px] font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400 uppercase tracking-widest">v2.0 PRO</span>
                </div>
            </div>

            <!-- 2. User Profile (IMEI Checker Style) -->
            <div class="mx-4 mb-6 p-3 rounded-xl bg-white/5 border border-white/5 flex items-center gap-3 group hover:bg-white/10 transition-colors cursor-pointer">
                <div class="h-10 w-10 rounded-full bg-gradient-to-br from-gray-700 to-gray-900 border border-white/10 flex items-center justify-center text-white font-bold text-sm shrink-0">
                    @(User.Identity?.Name?.Length > 0 ? User.Identity.Name.Substring(0,1).ToUpper() : "U")
                </div>
                <div class="flex-1 overflow-hidden">
                    <h6 class="text-sm font-bold text-white truncate mb-0">@(User.Identity?.Name ?? "Usuario")</h6>
                    <p class="text-[10px] text-gray-400 truncate mb-0 group-hover:text-purple-300 transition-colors">Administrador</p>
                </div>
                <i class="bi bi-gear-fill text-gray-500 group-hover:text-white transition-colors text-xs"></i>
            </div>

            <!-- 3. Navigation -->
            <div class="flex-1 overflow-y-auto px-4 flex flex-col gap-1 pb-4">
                @{
                    string currentPath = Context.Request.Path.ToString().ToLower();
                    string ActiveClass(string path) => currentPath.Contains(path.ToLower()) || (path == "/" && currentPath == "/") ? 
                        "bg-gradient-to-r from-purple-600 to-blue-500 text-white shadow-lg shadow-purple-500/20" : 
                        "text-gray-400 hover:text-white hover:bg-white/5";
                    
                    string IconClass(string path) => currentPath.Contains(path.ToLower()) || (path == "/" && currentPath == "/") ? "text-white" : "text-gray-500 group-hover:text-white";
                }

                <p class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest mt-2 mb-2 ml-2">Principal</p>

                <a asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Dashboard")">
                    <i class="bi bi-grid-fill @IconClass("Dashboard") transition-colors"></i> 
                    <span>Dashboard</span>
                </a>
                <a asp-controller="Ventas" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Ventas")">
                    <i class="bi bi-wallet-fill @IconClass("Ventas") transition-colors"></i> 
                    <span>Ventas</span>
                </a>
                <a asp-controller="Inventario" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Inventario")">
                    <i class="bi bi-box-seam-fill @IconClass("Inventario") transition-colors"></i> 
                    <span>Inventario</span>
                </a>
                <a asp-controller="Inventario" asp-action="Reparaciones" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Reparaciones")">
                    <i class="bi bi-tools @IconClass("Reparaciones") transition-colors"></i> 
                    <span>Reparaciones</span>
                </a>

                <p class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest mt-6 mb-2 ml-2">Administración</p>

                <a asp-controller="Producto" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Producto")">
                    <i class="bi bi-tags-fill @IconClass("Producto") transition-colors"></i> 
                    <span>Productos</span>
                </a>
                <a asp-controller="Compras" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Compras")">
                    <i class="bi bi-cart-fill @IconClass("Compras") transition-colors"></i> 
                    <span>Compras</span>
                </a>
                <a asp-controller="Gastos" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Gastos")">
                    <i class="bi bi-receipt @IconClass("Gastos") transition-colors"></i> 
                    <span>Gastos</span>
                </a>
                <a asp-controller="Garantias" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Garantias")">
                    <i class="bi bi-shield-check @IconClass("Garantias") transition-colors"></i> 
                    <span>Garantías</span>
                </a>
                <a asp-controller="Reportes" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium group @ActiveClass("Reportes")">
                    <i class="bi bi-bar-chart-fill @IconClass("Reportes") transition-colors"></i> 
                    <span>Reportes</span>
                </a>
            </div>
            
            <!-- Footer/Logout -->
            <div class="p-4 border-t border-white/5">
                <a asp-controller="Auth" asp-action="Logout" class="flex items-center gap-3 px-4 py-3 rounded-xl text-red-400 hover:text-white hover:bg-red-500/10 transition-all font-medium">
                     <i class="bi bi-box-arrow-right"></i>
                     <span>Cerrar Sesión</span>
                </a>
            </div>
        </div>

        <div id="page-content-wrapper">

            <nav class="navbar navbar-expand-lg px-4 py-3">
                <button class="btn btn-outline-secondary d-md-none border-0 text-white me-3" id="mobile-toggle">
                    <i class="bi bi-list fs-3"></i>
                </button>

                <div class="ms-auto flex items-center gap-6">
                    <!-- Notifications Icon -->
                    <button class="relative group p-1.5 text-gray-400 hover:text-white transition-colors outline-none">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                        <!-- Red Dot -->
                        <span class="absolute top-1.5 right-2 h-2.5 w-2.5 bg-red-500 border-2 border-[#1a1b2e] rounded-full"></span>
                    </button>

                    <!-- User Avatar (Logout Action) -->
                    <div class="flex items-center gap-3">
                        <a asp-controller="Auth" asp-action="Logout" class="relative group outline-none" title="Cerrar Sesión">
                            <div class="h-10 w-10 rounded-full bg-gradient-to-r from-blue-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm shadow-lg hover:ring-2 hover:ring-purple-500/50 transition-all cursor-pointer">
                                @{
                                    var uName = User.Identity?.Name ?? "Admin";
                                    var initials = uName.Length > 1 ? uName.Substring(0, 2).ToUpper() : uName.Substring(0, 1).ToUpper();
                                }
                                @initials
                            </div>
                        </a>
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-4 py-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // Select2: inicializar buscadores en selects con clase .select2-producto (Compras, Ventas, etc.)
        $(function () {
            $('.select2-producto').each(function () {
                var $el = $(this);
                var $modal = $el.closest('.modal');
                var opts = { placeholder: 'Escribe para buscar...', allowClear: true, width: '100%' };
                if ($modal.length) opts.dropdownParent = $modal;
                $el.select2(opts);
            });
        });

        const toggleBtn = document.getElementById("mobile-toggle");
        const sidebar = document.getElementById("sidebar-wrapper");
        const overlay = document.getElementById("overlay");

        function toggleMenu() {
            sidebar.classList.toggle("show-nav");
            overlay.classList.toggle("show-nav");
        }

        if(toggleBtn) {
            toggleBtn.addEventListener("click", (e) => {
                e.preventDefault();
                toggleMenu();
            });
        }

        if(overlay) {
            overlay.addEventListener("click", () => {
                toggleMenu();
            });
        }
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>