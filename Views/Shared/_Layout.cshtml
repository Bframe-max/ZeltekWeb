<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Zeltek</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Tema: claro por defecto; se aplica antes de pintar para evitar parpadeo -->
    <script>
        (function () {
            var t = 'light';
            try { t = localStorage.getItem('zeltek-theme') || 'light'; } catch (e) { }
            document.documentElement.setAttribute('data-theme', t);
        })();

        // Colores actuales del tema, para los gráficos de Chart.js de las vistas
        window.zc = function () {
            var s = getComputedStyle(document.documentElement);
            var v = function (n) { return s.getPropertyValue(n).trim(); };
            return { text: v('--z-text-2'), muted: v('--z-muted'), grid: v('--z-border'), surface: v('--z-surface') };
        };
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Tema claro de Zeltek -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Librerías JS en el head: varias vistas tienen scripts en medio de la página que usan $ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Tailwind CSS (No Preflight to avoid Bootstrap conflicts) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        corePlugins: {
          preflight: false,
        },
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              mono: ['JetBrains Mono', 'ui-monospace', 'monospace'],
            },
            colors: {
              'card-dark': '#ffffff',
              'border-dark': '#e6e9f2',
            }
          }
        }
      }
    </script>

    <style>
        /* ================= ESTRUCTURA ================= */
        #wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        #sidebar-wrapper {
            width: var(--sidebar-width);
            min-width: var(--sidebar-width);
            height: 100vh;
            position: sticky;
            top: 0;
            background: var(--z-surface);
            border-right: 1px solid var(--z-border);
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: left .25s ease;
        }

        #page-content-wrapper {
            flex-grow: 1;
            width: 100%;
            min-width: 0;
        }

        #overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(30, 36, 51, .35);
            z-index: 999;
        }

        /* ================= MENÚ ================= */
        .z-brand { padding: 22px 20px; border-bottom: 1px solid var(--z-border); }
        .z-logo {
            width: 44px; height: 44px; border-radius: 12px;
            background: var(--z-primary); color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 1.15rem;
            box-shadow: 0 6px 16px -6px rgba(79, 70, 229, .6);
        }
        .z-section {
            font-size: .72rem; font-weight: 700; letter-spacing: .1em;
            text-transform: uppercase; color: var(--z-subtle);
            margin: 22px 0 10px 18px;
        }
        .z-link {
            display: flex; align-items: center; gap: 14px;
            padding: 12px 18px; margin-bottom: 4px;
            border-radius: 12px;
            color: var(--z-text-2); font-weight: 500; font-size: .95rem;
            transition: background-color .15s ease, color .15s ease;
        }
        .z-link i { font-size: 1.15rem; color: var(--z-muted); transition: color .15s ease; }
        .z-link:hover { background: var(--z-surface-2); color: var(--z-text); }
        .z-link:hover i { color: var(--z-primary); }
        .z-link.active {
            background: var(--z-primary); color: #fff; font-weight: 600;
            box-shadow: 0 8px 18px -8px rgba(79, 70, 229, .7);
        }
        .z-link.active i { color: #fff; }

        .z-user { border-top: 1px solid var(--z-border); padding: 16px 18px; }
        .z-avatar {
            width: 42px; height: 42px; border-radius: 50%;
            background: var(--z-primary-soft); color: var(--z-primary);
            display: flex; align-items: center; justify-content: center;
            font-weight: 700;
        }
        .z-logout { color: var(--z-muted); font-size: 1.2rem; padding: 6px; border-radius: 8px; }
        .z-logout:hover { color: var(--z-danger); background: rgba(239, 68, 68, .1); }

        .z-theme {
            width: 38px; height: 38px; border-radius: 10px;
            display: inline-flex; align-items: center; justify-content: center;
            color: var(--z-muted); font-size: 1.1rem;
            transition: background-color .15s ease, color .15s ease;
        }
        .z-theme:hover { background: var(--z-surface-2); color: var(--z-primary); }
        /* Muestra la luna en modo claro y el sol en modo oscuro */
        .z-theme .bi-sun { display: none; }
        html[data-theme="dark"] .z-theme .bi-sun { display: inline; }
        html[data-theme="dark"] .z-theme .bi-moon { display: none; }

        /* ================= RESPONSIVE ================= */
        #mobile-bar { display: none; }

        @@media (max-width: 768px) {
            #sidebar-wrapper {
                position: fixed;
                left: calc(-1 * var(--sidebar-width));
                box-shadow: var(--z-shadow-lg);
            }
            #sidebar-wrapper.show-nav { left: 0; }
            #overlay.show-nav { display: block; }
            #mobile-bar {
                display: flex; align-items: center; gap: 12px;
                padding: 12px 16px;
                background: var(--z-surface);
                border-bottom: 1px solid var(--z-border);
                position: sticky; top: 0; z-index: 900;
            }
        }
    </style>
</head>

<body>

    <div id="overlay"></div>

    <div id="wrapper">

        <aside id="sidebar-wrapper">
            <!-- Marca -->
            <div class="z-brand flex items-center gap-3">
                <div class="z-logo">Z</div>
                <div class="leading-tight flex-1">
                    <div class="font-bold text-slate-900 tracking-wide" style="font-size:1.05rem">ZELTEK</div>
                    <div class="text-sm text-slate-500">ERP Nicaragua</div>
                </div>
                <button type="button" class="z-theme" data-theme-toggle title="Cambiar modo claro / oscuro" aria-label="Cambiar modo claro / oscuro">
                    <i class="bi bi-moon"></i><i class="bi bi-sun"></i>
                </button>
            </div>

            <!-- Navegación -->
            <nav class="flex-1 overflow-y-auto px-3 pb-4">
                @{
                    string currentPath = Context.Request.Path.ToString().ToLower();
                    // "Reparaciones" vive dentro de /Inventario: se evalúa primero para no marcar los dos
                    bool enReparaciones = currentPath.Contains("/inventario/reparaciones");
                    string Active(string path) =>
                        path == "Reparaciones" ? (enReparaciones ? "active" : "")
                        : path == "Inventario" ? (currentPath.Contains("/inventario") && !enReparaciones ? "active" : "")
                        : currentPath.Contains(path.ToLower()) ? "active" : "";
                }

                <p class="z-section">Principal</p>

                <a asp-controller="Dashboard" asp-action="Index" class="z-link @Active("Dashboard")">
                    <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                </a>
                <a asp-controller="Ventas" asp-action="Index" class="z-link @Active("Ventas")">
                    <i class="bi bi-cart3"></i><span>Ventas</span>
                </a>
                <a asp-controller="Inventario" asp-action="Index" class="z-link @Active("Inventario")">
                    <i class="bi bi-display"></i><span>Inventario</span>
                </a>
                <a asp-controller="Inventario" asp-action="Reparaciones" class="z-link @Active("Reparaciones")">
                    <i class="bi bi-wrench-adjustable"></i><span>Reparaciones</span>
                </a>

                <p class="z-section">Administración</p>

                <a asp-controller="Producto" asp-action="Index" class="z-link @Active("Producto")">
                    <i class="bi bi-box-seam"></i><span>Productos</span>
                </a>
                <a asp-controller="Compras" asp-action="Index" class="z-link @Active("Compras")">
                    <i class="bi bi-bag"></i><span>Compras</span>
                </a>
                <a asp-controller="Gastos" asp-action="Index" class="z-link @Active("Gastos")">
                    <i class="bi bi-receipt"></i><span>Gastos</span>
                </a>
                <a asp-controller="Garantias" asp-action="Index" class="z-link @Active("Garantias")">
                    <i class="bi bi-shield-check"></i><span>Garantías</span>
                </a>
                <a asp-controller="Reportes" asp-action="Index" class="z-link @Active("Reportes")">
                    <i class="bi bi-bar-chart-line"></i><span>Reportes</span>
                </a>
            </nav>

            <!-- Usuario -->
            @{
                var uName = User.Identity?.Name ?? "Usuario";
                var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario";
            }
            <div class="z-user flex items-center gap-3">
                <div class="z-avatar shrink-0">@uName.Substring(0, 1).ToUpper()</div>
                <div class="flex-1 min-w-0 leading-tight">
                    <div class="font-semibold text-slate-900 truncate">@(rol == "Admin" ? "Administrador" : uName)</div>
                    <div class="text-xs text-slate-500 uppercase tracking-wide truncate">@uName</div>
                </div>
                <a asp-controller="Auth" asp-action="Logout" class="z-logout" title="Cerrar sesión">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </aside>

        <div id="page-content-wrapper">

            <!-- Barra superior solo en móvil -->
            <div id="mobile-bar">
                <button class="btn btn-outline-secondary border-0" id="mobile-toggle" aria-label="Abrir menú">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="z-logo" style="width:34px;height:34px;font-size:.95rem">Z</div>
                <span class="font-bold text-slate-900 flex-1">ZELTEK</span>
                <button type="button" class="z-theme" data-theme-toggle title="Cambiar modo claro / oscuro" aria-label="Cambiar modo claro / oscuro">
                    <i class="bi bi-moon"></i><i class="bi bi-sun"></i>
                </button>
            </div>

            <main class="container-fluid px-4 px-lg-5 py-4 py-lg-5">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        // Select2: inicializar buscadores en selects con clase .select2-producto (Compras, Ventas, etc.)
        $(function () {
            $('.select2-producto').each(function () {
                var $el = $(this);
                var $modal = $el.closest('.modal');
                var opts = { placeholder: 'Escribe para buscar...', allowClear: true, width: '100%' };
                if ($modal.length) opts.dropdownParent = $modal;
                $el.select2(opts);
            });
        });

        // ================= MODO CLARO / OSCURO =================
        // Cambia en los gráficos ya dibujados los colores del tema anterior por los del nuevo
        function zRecolorCharts(antes, ahora) {
            if (!window.Chart || !Chart.instances) return;
            var mapa = {};
            Object.keys(antes).forEach(function (k) { mapa[antes[k]] = ahora[k]; });
            var vistos = new WeakSet();
            function walk(o) {
                if (!o || typeof o !== 'object' || vistos.has(o) || o instanceof HTMLElement) return;
                vistos.add(o);
                Object.keys(o).forEach(function (k) {
                    if (typeof o[k] === 'string' && mapa[o[k]]) o[k] = mapa[o[k]];
                    else walk(o[k]);
                });
            }
            Object.values(Chart.instances).forEach(function (ch) {
                walk(ch.config.options);
                ch.config.data.datasets.forEach(walk);
                ch.update('none');
            });
        }

        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var root = document.documentElement;
                var antes = zc();
                var nuevo = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                root.setAttribute('data-theme', nuevo);
                try { localStorage.setItem('zeltek-theme', nuevo); } catch (e) { }
                zRecolorCharts(antes, zc());
            });
        });

        // SweetAlert2 con el color principal
        if (window.Swal) {
            window.Swal = Swal.mixin({
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#94a3b8'
            });
        }

        const toggleBtn = document.getElementById("mobile-toggle");
        const sidebar = document.getElementById("sidebar-wrapper");
        const overlay = document.getElementById("overlay");

        function toggleMenu() {
            sidebar.classList.toggle("show-nav");
            overlay.classList.toggle("show-nav");
        }

        if (toggleBtn) {
            toggleBtn.addEventListener("click", (e) => {
                e.preventDefault();
                toggleMenu();
            });
        }

        if (overlay) {
            overlay.addEventListener("click", () => {
                toggleMenu();
            });
        }
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
