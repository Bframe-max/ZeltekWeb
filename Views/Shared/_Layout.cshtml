<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Zeltek</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        /* Select2 en tema oscuro */
        .select2-container--default .select2-selection--single { background-color: #1b1b29; border-color: var(--border-color); color: #fff; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { color: #fff; }
        .select2-container--default .select2-results__option--highlighted[aria-selected] { background-color: var(--accent-color); }
        .select2-dropdown { background-color: #1e1e2d; border-color: var(--border-color); }
        .select2-container--default .select2-results__option[aria-selected=true] { background-color: #2d2d3f; color: #fff; }
        .select2-search--dropdown .select2-search__field { background: #1b1b29; color: #fff; border-color: var(--border-color); }
    </style>

    <style>
        /* ================= TEMA OSCURO (VARIABLES) ================= */
        :root {
            --bg-body: #151521;
            --bg-card: #1e1e2d;
            --text-primary: #ffffff;
            --text-secondary: #92929f;
            --accent-color: #5646ff;
            --border-color: #2d2d3f;
            --sidebar-width: 260px;
        }

        /* 1. FORZAMOS EL BODY OSCURO */
        body {
            background-color: var(--bg-body) !important;
            color: var(--text-primary) !important;
            font-family: system-ui, -apple-system, sans-serif;
            overflow-x: hidden;
        }

        /* 2. ESTRUCTURA (FLEXBOX) */
        #wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
            overflow: hidden;
        }

        /* Sidebar Base */
        #sidebar-wrapper {
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            background-color: var(--bg-card) !important; /* Forzado */
            border-right: 1px solid var(--border-color);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        /* Contenido Base */
        #page-content-wrapper {
            flex-grow: 1;
            width: 100%;
            min-width: 0;
        }

        /* Overlay para móvil */
        #overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 999;
        }

        /* 3. LÓGICA PC (PANTALLA GRANDE) */
        /* Nota: Usamos @@media porque estamos en un archivo .cshtml */
        @@media (min-width: 769px) {
            #sidebar-wrapper {
                margin-left: 0;
                position: relative; /* Ocupa espacio físico */
            }

            #mobile-toggle, #overlay {
                display: none !important;
            }
        }

        /* 4. LÓGICA MÓVIL (PANTALLA PEQUEÑA) */
        @@media (max-width: 768px) {
            #sidebar-wrapper {
                position: fixed; /* Flota encima */
                top: 0;
                bottom: 0;
                left: -260px; /* Escondido */
                height: 100vh;
                box-shadow: 5px 0 15px rgba(0,0,0,0.5);
            }

                #sidebar-wrapper.show-nav {
                    left: 0; /* Aparece */
                }

            #overlay.show-nav {
                display: block;
            }
        }

        /* ================= CORRECCIÓN DE COLORES (FORCE DARK) ================= */

        /* TARJETAS: Matamos el blanco de Bootstrap con !important */
        .card {
            background-color: var(--bg-card) !important;
            border: 1px solid var(--border-color) !important;
            color: var(--text-primary) !important;
        }

        /* TEXTOS: Forzamos blanco en títulos que Bootstrap pone negros */
        h1, h2, h3, h4, h5, h6, .card-title, .card-text {
            color: var(--text-primary) !important;
        }

        /* NAVBAR: Transparente y textos blancos */
        .navbar {
            background-color: var(--bg-body) !important;
            border-bottom: 1px solid var(--border-color);
        }

        /* ESTILOS DEL MENÚ */
        .list-group-item {
            background: transparent !important;
            color: var(--text-secondary) !important;
            border: none !important;
            padding: 12px 20px;
        }

            .list-group-item:hover, .list-group-item.active {
                background: rgba(86,70,255, 0.15) !important;
                color: #ffffff !important;
                border-left: 3px solid var(--accent-color) !important;
            }

        .sidebar-heading {
            padding: 1.5rem;
            font-size: 1.4rem;
            font-weight: bold;
            color: var(--text-primary) !important;
            border-bottom: 1px solid var(--border-color);
        }
    </style>
</head>

<body>

    <div id="overlay"></div>

    <div id="wrapper">

        <div id="sidebar-wrapper">
            <div class="sidebar-heading">
                🚀 Zeltek <span class="badge bg-primary ms-2" style="font-size:0.5em; vertical-align: text-top;">v2.0</span>
            </div>

            <div class="list-group list-group-flush p-3">
                <small class="text-uppercase text-secondary fw-bold ps-2 mb-2" style="font-size:.7rem;">Principal</small>

                <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a asp-controller="Ventas" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-cash-stack me-2"></i> Ventas
                </a>
                <a asp-controller="Inventario" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-box-seam me-2"></i> Inventario
                </a>
                <a asp-controller="Inventario" asp-action="Reparaciones" class="list-group-item list-group-item-action">
                    <i class="bi bi-wrench me-2"></i> Reparaciones
                </a>

                <small class="text-uppercase text-secondary fw-bold mt-4 ps-2 mb-2" style="font-size:.7rem;">Administración</small>

                <a asp-controller="Producto" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-tags me-2"></i> Productos
                </a>
                <a asp-controller="Compras" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-cart me-2"></i> Compras
                </a>
                <a asp-controller="Gastos" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-receipt me-2"></i> Gastos Operativos
                </a>
                <a asp-controller="Garantias" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-shield-check me-2"></i> Garantías
                </a>
                <a asp-controller="Reportes" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-graph-up me-2"></i> Reportes
                </a>
            </div>
        </div>

        <div id="page-content-wrapper">

            <nav class="navbar navbar-expand-lg px-4 py-3">
                <button class="btn btn-outline-secondary d-md-none border-0 text-white me-3" id="mobile-toggle">
                    <i class="bi bi-list fs-3"></i>
                </button>

                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="d-none d-md-block text-white">
                        Hola, <strong>@User.Identity?.Name</strong>
                    </span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-danger btn-sm">
                        Salir
                    </a>
                </div>
            </nav>

            <div class="container-fluid px-4 py-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // Select2: inicializar buscadores en selects con clase .select2-producto (Compras, Ventas, etc.)
        $(function () {
            $('.select2-producto').each(function () {
                var $el = $(this);
                var $modal = $el.closest('.modal');
                var opts = { placeholder: 'Escribe para buscar...', allowClear: true, width: '100%' };
                if ($modal.length) opts.dropdownParent = $modal;
                $el.select2(opts);
            });
        });

        const toggleBtn = document.getElementById("mobile-toggle");
        const sidebar = document.getElementById("sidebar-wrapper");
        const overlay = document.getElementById("overlay");

        function toggleMenu() {
            sidebar.classList.toggle("show-nav");
            overlay.classList.toggle("show-nav");
        }

        if(toggleBtn) {
            toggleBtn.addEventListener("click", (e) => {
                e.preventDefault();
                toggleMenu();
            });
        }

        if(overlay) {
            overlay.addEventListener("click", () => {
                toggleMenu();
            });
        }
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>