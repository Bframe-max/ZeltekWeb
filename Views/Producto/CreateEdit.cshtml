@model ZeltekWeb.Models.ProductoCreateEditViewModel

@{
    var esEdicion = Model.ProductoID > 0;
    ViewData["Title"] = esEdicion ? "Editar Producto" : "Nuevo Producto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card bg-card border-0 shadow-lg mt-4">
            <div class="card-header bg-transparent border-bottom border-secondary py-3">
                <h4 class="text-white fw-bold mb-0">
                    @(esEdicion ? "✏️ Editar Producto" : "📦 Nuevo Producto")
                </h4>
            </div>
            <div class="card-body p-4">

                <form id="formProducto" asp-action="@(esEdicion ? "Edit" : "Create")" asp-route-id="@(esEdicion ? Model.ProductoID : (int?)null)" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-3 mb-3" role="alert">
                            <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Errores al guardar</strong>
                            <div asp-validation-summary="All" class="mt-2 small" style="white-space: pre-wrap; max-height: 40vh; overflow-y: auto;"></div>
                        </div>
                    }
                    @if (esEdicion)
                    {
                        <input type="hidden" asp-for="ProductoID" />
                    }

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label text-secondary small fw-bold"></label>
                            <input asp-for="Nombre" class="form-control bg-dark text-white border-secondary" placeholder="Ej: MacBook Pro 14" autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                            
                            <!-- Alerta de Duplicados (sin form anidado: el form-reactivar está fuera del formProducto) -->
                            <div id="alert-duplicado" class="alert alert-warning mt-2 d-none py-2 small">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <span id="msg-duplicado">Este producto ya existe.</span>
                                <button type="button" id="btn-reactivar-producto" class="btn btn-link p-0 align-baseline text-dark fw-bold d-none">Click aquí para reactivarlo</button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Modelo" class="form-label text-secondary small fw-bold"></label>
                            <input asp-for="Modelo" class="form-control bg-dark text-white border-secondary" placeholder="Ej: M3 Pro" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label text-secondary small fw-bold"></label>
                        <textarea asp-for="Descripcion" class="form-control bg-dark text-white border-secondary" rows="2" placeholder="Descripción opcional"></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Marca</label>
                            <div class="input-group">
                                <select asp-for="MarcaID" asp-items="ViewBag.Marcas" class="form-select bg-dark text-white border-secondary">
                                    <option value="">-- Seleccione --</option>
                                </select>
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalMarca" title="Nueva Marca">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            <span asp-validation-for="MarcaID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Categoría</label>
                            <div class="input-group">
                                <select asp-for="CategoriaID" asp-items="ViewBag.Categorias" class="form-select bg-dark text-white border-secondary">
                                    <option value="">-- Sin categoría --</option>
                                </select>
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalCategoria" title="Nueva Categoría">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CostoReferencia" class="form-label text-secondary small fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">$</span>
                                <input asp-for="CostoReferencia" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end pb-2">
                            <div class="form-check">
                                <input asp-for="EsUnico" class="form-check-input" />
                                <label asp-for="EsUnico" class="form-check-label text-secondary">
                                    Producto con serial (Laptop / iPhone)
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr class="border-secondary my-4" />

                    <div class="d-flex gap-2">
                        <button type="submit" id="btnGuardarProducto" class="btn btn-primary fw-bold py-2 px-4">
                            <i class="bi bi-check-lg me-2"></i>Guardar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
                <!-- Form reactivar (fuera del formProducto para evitar formularios anidados) -->
                <form id="form-reactivar" asp-action="Reactivar" method="post" class="d-none">
                    <input type="hidden" name="id" id="id-reactivar" />
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // ==========================================
            // 1. VALIDACIÓN DE DUPLICADOS
            // ==========================================
            let timer;
            const $nombreInput = $("#Nombre");
            const $alert = $("#alert-duplicado");
            const $btnGuardar = $("#btnGuardarProducto");
            const excludeId = "@(Model.ProductoID > 0 ? Model.ProductoID : "")";

            // Envío: el botón tiene type="submit" y está DENTRO de #formProducto, así que el clic dispara el submit del form.
            $("#formProducto").on("submit", function (e) {
                console.log("Intentando enviar formulario...");
                console.log("Datos del formulario:", $(this).serialize());
                if ($btnGuardar.prop("disabled")) {
                    console.warn("Botón Guardar deshabilitado (ej. producto duplicado).");
                    alert("Envío bloqueado: el botón Guardar está deshabilitado (p. ej. producto duplicado). Revisa el nombre.");
                    e.preventDefault();
                    return false;
                }
                console.log("Formulario se enviará al servidor (POST).");
                return true;
            });

            $nombreInput.on("keyup", function () {
                clearTimeout(timer);
                const nombre = $(this).val().trim();
                
                $alert.addClass("d-none");
                $btnGuardar.prop("disabled", false);

                if (nombre.length < 3) return;

                timer = setTimeout(function () {
                    $.get('@Url.Action("CheckNombre", "Producto")', { nombre: nombre, excludeId: excludeId })
                        .done(function (data) {
                            if (data && data.exists) {
                                $alert.removeClass("d-none");
                                if (data.isDeleted) {
                                    $("#msg-duplicado").text("Este producto existe pero fue eliminado.");
                                    $("#btn-reactivar-producto").removeClass("d-none");
                                    $("#id-reactivar").val(data.id);
                                } else {
                                    $("#msg-duplicado").text("⛔ Este producto ya existe y está activo.");
                                    $("#btn-reactivar-producto").addClass("d-none");
                                    $btnGuardar.prop("disabled", true);
                                }
                            }
                        })
                        .fail(function (xhr, status, err) {
                            console.error("CheckNombre error:", status, err);
                            $btnGuardar.prop("disabled", false);
                            alert("No se pudo verificar si el producto existe. Revisa la conexión e intenta de nuevo.");
                        });
                }, 500);
            });

            // ==========================================
            // 2. AUTO-CATEGORIZACIÓN (Cargador/Adaptador → Accesorio o Cargador, sin serial)
            // ==========================================
            $nombreInput.on("input", function () {
                const nombre = $(this).val().toLowerCase();
                
                // Cargador / Adaptador: Categoría Cargador si existe, si no Accesorio; y NO es único (accesorio)
                if (nombre.includes("cargador") || nombre.includes("adaptador")) {
                    if (!selectByText("#CategoriaID", "Cargador")) selectByText("#CategoriaID", "Accesorio");
                    $("#EsUnico").prop("checked", false);
                }

                // Marcas + Categoría
                if (nombre.includes("latitude") || nombre.includes("precision") || nombre.includes("xps")) {
                    selectByText("#MarcaID", "Dell");
                    selectByText("#CategoriaID", "Laptop");
                }
                else if (nombre.includes("elitebook") || nombre.includes("probook")) {
                    selectByText("#MarcaID", "HP");
                    selectByText("#CategoriaID", "Laptop");
                }
                else if (nombre.includes("iphone")) {
                    selectByText("#MarcaID", "Apple");
                    selectByText("#CategoriaID", "Celular");
                }
                else if (nombre.includes("ipad")) {
                    selectByText("#MarcaID", "Apple");
                    selectByText("#CategoriaID", "Tablet");
                }
            });

            function selectByText(selector, text) {
                const $opts = $(selector + " option");
                const found = $opts.filter(function () {
                    return $(this).text().trim().toLowerCase() === text.toLowerCase();
                });
                if (found.length) {
                    found.prop('selected', true);
                    return true;
                }
                const partial = $opts.filter(function () {
                    return $(this).text().toLowerCase().includes(text.toLowerCase());
                });
                if (partial.length) {
                    partial.prop('selected', true);
                    return true;
                }
                return false;
            }

            // ==========================================
            // 3. MODALES DE CREACIÓN RÁPIDA (errores dentro del modal, no duplicados)
            // ==========================================
            
            // Creación rápida Marca: asegurar que el select reciba el ID numérico real y el formulario lo envíe
            function guardarMarcaRapida() {
                const nombre = $("#marca-nombre").val().trim();
                const $err = $("#error-marca");
                const $select = $("#MarcaID");
                $err.addClass("d-none").text("");
                if (!nombre) {
                    $err.text("Escribe el nombre de la marca.").removeClass("d-none");
                    return;
                }
                $.post('@Url.Action("CrearMarcaRapida")', { nombre: nombre })
                    .done(function(res) {
                        if (res.success && res.id) {
                            const idVal = String(res.id);
                            const newOption = new Option(res.nombre, idVal, true, true);
                            $select.append(newOption);
                            $select.val(idVal);
                            $select.trigger("change");
                            cerrarModalB5("modalMarca");
                            $("#marca-nombre").val("");
                        } else {
                            $err.html(res.message || "Error al guardar.").removeClass("d-none");
                            alert(res.message || "Error al guardar la marca.");
                        }
                    })
                    .fail(function(xhr, status, err) {
                        console.error("CrearMarcaRapida error:", status, err);
                        let msg = "No se pudo guardar la marca. ";
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        else if (xhr.responseText) {
                            try {
                                const j = JSON.parse(xhr.responseText);
                                if (j.message) msg = j.message;
                            } catch (e) {
                                if (xhr.responseText.length < 200) msg += xhr.responseText;
                                else msg += "Error del servidor.";
                            }
                        } else msg += (xhr.statusText || status || "Error de conexión.");
                        $err.html(msg).removeClass("d-none");
                        alert(msg);
                    });
            }

            // Creación rápida Categoría: mismo criterio para CategoriaID
            function guardarCategoriaRapida() {
                const nombre = $("#categoria-nombre").val().trim();
                const $err = $("#error-categoria");
                const $select = $("#CategoriaID");
                $err.addClass("d-none").text("");
                if (!nombre) {
                    $err.text("Escribe el nombre de la categoría.").removeClass("d-none");
                    return;
                }
                $.post('@Url.Action("CrearCategoriaRapida")', { nombre: nombre })
                    .done(function(res) {
                        if (res.success && res.id) {
                            const idVal = String(res.id);
                            const newOption = new Option(res.nombre, idVal, true, true);
                            $select.append(newOption);
                            $select.val(idVal);
                            $select.trigger("change");
                            cerrarModalB5("modalCategoria");
                            $("#categoria-nombre").val("");
                        } else {
                            $err.html(res.message || "Error al guardar.").removeClass("d-none");
                            alert(res.message || "Error al guardar la categoría.");
                        }
                    })
                    .fail(function(xhr, status, err) {
                        console.error("CrearCategoriaRapida error:", status, err);
                        let msg = "No se pudo guardar la categoría. ";
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        else if (xhr.responseText) {
                            try {
                                const j = JSON.parse(xhr.responseText);
                                if (j.message) msg = j.message;
                            } catch (e) {
                                if (xhr.responseText.length < 200) msg += xhr.responseText;
                                else msg += "Error del servidor.";
                            }
                        } else msg += (xhr.statusText || status || "Error de conexión.");
                        $err.html(msg).removeClass("d-none");
                        alert(msg);
                    });
            }

            // Cerrar modal con Bootstrap 5 (compatible con BS5 sin jQuery)
            function cerrarModalB5(id) {
                var el = document.getElementById(id);
                if (el && typeof bootstrap !== "undefined" && bootstrap.Modal) {
                    var inst = bootstrap.Modal.getInstance(el);
                    if (inst) inst.hide(); else new bootstrap.Modal(el).hide();
                } else if ($("#" + id).modal) {
                    $("#" + id).modal("hide");
                }
            }

            $("#btn-save-marca").click(guardarMarcaRapida);
            $("#btn-save-categoria").click(guardarCategoriaRapida);

            // Botón "Click aquí para reactivarlo" envía el form-reactivar (está fuera del formProducto)
            $("#btn-reactivar-producto").on("click", function () {
                $("#form-reactivar").submit();
            });

            // Limpiar error al abrir modales (Bootstrap 5: show.bs.modal)
            $("#modalMarca").on("show.bs.modal", function () { $("#error-marca").addClass("d-none").text(""); });
            $("#modalCategoria").on("show.bs.modal", function () { $("#error-categoria").addClass("d-none").text(""); });
        });
    </script>
}

<!-- Modal Nueva Marca (Bootstrap 5 estándar, tema oscuro) -->
<div class="modal fade" id="modalMarca" tabindex="-1" aria-labelledby="modalMarcaLabel" aria-hidden="true" data-bs-backdrop="true" data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-secondary text-white shadow">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold" id="modalMarcaLabel">
                    <i class="bi bi-tag-fill me-2"></i>Nueva Marca
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger py-2 small d-none" id="error-marca" role="alert"></div>
                <label class="form-label text-secondary mb-2">Nombre de la marca</label>
                <input type="text" id="marca-nombre" class="form-control bg-secondary text-white border-secondary" placeholder="Ej: Dell, HP, Apple..." autocomplete="off" />
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn-save-marca">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nueva Categoría (Bootstrap 5 estándar, tema oscuro) -->
<div class="modal fade" id="modalCategoria" tabindex="-1" aria-labelledby="modalCategoriaLabel" aria-hidden="true" data-bs-backdrop="true" data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-secondary text-white shadow">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold" id="modalCategoriaLabel">
                    <i class="bi bi-grid-3x3-gap-fill me-2"></i>Nueva Categoría
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger py-2 small d-none" id="error-categoria" role="alert"></div>
                <label class="form-label text-secondary mb-2">Nombre de la categoría</label>
                <input type="text" id="categoria-nombre" class="form-control bg-secondary text-white border-secondary" placeholder="Ej: Laptop, Celular, Accesorio..." autocomplete="off" />
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-success" id="btn-save-categoria">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>
