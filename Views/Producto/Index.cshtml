@model List<ZeltekWeb.Models.ProductoViewModel>

@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-white">📦 Catálogo de Productos</h2>
    <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Nuevo Producto
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card bg-card border-start border-4 border-primary">
            <div class="card-body">
                <small class="text-secondary text-uppercase fw-bold">Total Productos</small>
                <h3 class="text-white fw-bold mb-0">@Model.Count</h3>
                <small class="text-secondary">En catálogo activo</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-card border-start border-4 border-info">
            <div class="card-body">
                <small class="text-secondary text-uppercase fw-bold">Con serial</small>
                <h3 class="text-info fw-bold mb-0">@Model.Count(p => p.EsUnico)</h3>
                <small class="text-secondary">Laptops, iPhones, etc.</small>
            </div>
        </div>
    </div>
</div>

<div class="card bg-card border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="border-bottom: 1px solid var(--border-color);">
                <tr>
                    <th class="ps-4 text-white">ID</th>
                    <th class="text-white">Nombre</th>
                    <th class="text-white">Marca</th>
                    <th class="text-white">Categoría</th>
                    <th class="text-center text-white">Tipo</th>
                    <th class="text-end pe-4 text-white">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-4 text-secondary">#@p.ProductoID</td>
                        <td>
                            <span class="fw-bold text-white">@p.Nombre</span>
                        </td>
                        <td>
                            <span class="badge bg-dark text-info border border-info border-opacity-25 px-3">@p.Marca</span>
                        </td>
                        <td class="text-secondary">@p.Categoria</td>
                        <td class="text-center">
                            @if (p.EsUnico)
                            {
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3">📱 Con serial</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25 px-3">📦 Accesorio</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@p.ProductoID"
                                   class="btn btn-sm btn-outline-warning" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@p.ProductoID"
                                   class="btn btn-sm btn-outline-danger" title="Eliminar"
                                   onclick="return confirm('¿Seguro que desea eliminar este producto?');">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-secondary">
                            <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                            No hay productos registrados. Crea el primero.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
