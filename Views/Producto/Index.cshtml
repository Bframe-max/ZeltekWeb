@model List<ZeltekWeb.Models.ProductoViewModel>

@{
    ViewData["Title"] = "Productos";
}

<!-- Header & Actions -->
<div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-6">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 tracking-tight">Catálogo de Productos</h2>
        <p class="text-slate-500 text-sm mt-1">Gestión del inventario maestro</p>
    </div>
    <a asp-action="Create" class="group flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-lg shadow-blue-600/20 transition-all transform hover:scale-105">
        <svg class="w-5 h-5 transition-transform group-hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Nuevo Producto
    </a>
</div>

<!-- KPIs / Bento Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <!-- Total Products -->
    <div class="bg-white rounded-2xl p-6 shadow-lg shadow-slate-200/60 border border-slate-100 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <svg class="w-24 h-24 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        </div>
        <div class="relative z-10">
            <div class="flex items-center gap-3 mb-2">
                <div class="p-2 rounded-lg bg-blue-500/10 text-blue-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                </div>
                <h3 class="text-slate-500 text-sm font-semibold uppercase tracking-wider">Total Productos</h3>
            </div>
            <p class="text-4xl font-bold text-slate-800 mb-1">@Model.Count</p>
            <p class="text-blue-600 text-xs font-medium">En catálogo activo</p>
        </div>
    </div>

    <!-- With Serial -->
    <div class="bg-white rounded-2xl p-6 shadow-lg shadow-slate-200/60 border border-slate-100 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <svg class="w-24 h-24 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v1m6 11h2m-6 0h-2v4h-4v-4H8m13-9v2m-3-2v2m-3-2v2m-3-2v2m-3-2v2m-3-2v2m-3-2v2m-3-2v2m-3-2v2"></path></svg>
        </div>
        <div class="relative z-10">
            <div class="flex items-center gap-3 mb-2">
                <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                </div>
                <h3 class="text-slate-500 text-sm font-semibold uppercase tracking-wider">Con Serial</h3>
            </div>
            <p class="text-4xl font-bold text-slate-800 mb-1">@Model.Count(p => p.EsUnico)</p>
            <p class="text-emerald-600 text-xs font-medium">Equipos únicos (Laptops, Celulares)</p>
        </div>
    </div>
</div>

<!-- Product Table -->
<div class="bg-white rounded-2xl shadow-lg shadow-slate-200/60 border border-slate-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50">
                    <th class="p-5 text-xs font-medium text-slate-400 uppercase tracking-wider pl-6">ID</th>
                    <th class="p-5 text-xs font-medium text-slate-400 uppercase tracking-wider">Nombre</th>
                    <th class="p-5 text-xs font-medium text-slate-400 uppercase tracking-wider">Marca</th>
                    <th class="p-5 text-xs font-medium text-slate-400 uppercase tracking-wider">Categoría</th>
                    <th class="p-5 text-xs font-medium text-slate-400 uppercase tracking-wider text-center">Tipo</th>
                    <th class="p-5 text-xs font-medium text-slate-400 uppercase tracking-wider text-right pr-6">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var p in Model)
                {
                    <tr class="group hover:bg-slate-50 transition-colors">
                        <td class="p-5 align-middle pl-6 text-slate-400 font-mono text-sm">#@p.ProductoID</td>
                        <td class="p-5 align-middle">
                            <span class="text-slate-800 font-bold text-base block">@p.Nombre</span>
                        </td>
                        <td class="p-5 align-middle">
                            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200">@p.Marca</span>
                        </td>
                        <td class="p-5 align-middle text-slate-500 text-sm">@p.Categoria</td>
                        <td class="p-5 align-middle text-center">
                            @if (p.EsUnico)
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                    Con serial
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-500/10 text-purple-600 border border-purple-500/20">
                                    Accesorio
                                </span>
                            }
                        </td>
                        <td class="p-5 align-middle text-right pr-6">
                            <div class="flex items-center justify-end gap-3">
                                <a asp-action="Edit" asp-route-id="@p.ProductoID" 
                                   class="text-slate-500 hover:text-blue-600 transition-colors p-2 hover:bg-indigo-700/10 rounded-lg" title="Editar">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                </a>
                                <a asp-action="Delete" asp-route-id="@p.ProductoID" 
                                   class="text-slate-500 hover:text-red-600 transition-colors p-2 hover:bg-red-500/10 rounded-lg" title="Eliminar"
                                   onclick="return confirm('¿Seguro que desea eliminar este producto?');">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-12 text-slate-400">
                            <div class="mb-4">
                                <svg class="w-16 h-16 mx-auto text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                            </div>
                            <p class="text-lg font-medium text-slate-500">No hay productos registrados</p>
                            <p class="text-sm">Comienza agregando uno nuevo al catálogo.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
