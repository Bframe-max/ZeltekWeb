@model LoginVM
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-card card border-0 shadow">
    <div class="card-body p-4 p-sm-5">
        <!-- Encabezado -->
        <div class="text-center mb-4">
            <div class="display-4 mb-2">🚀</div>
            <h1 class="h3 fw-bold text-white mb-0">Zeltek v2.0</h1>
            <p class="text-secondary small mt-1">Inicia sesión en tu cuenta</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger py-2 mb-3">
                @Html.ValidationSummary(false, "", new { @class = "mb-0 small" })
            </div>
        }

        <form asp-action="Login" asp-controller="Auth" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Usuario" class="form-label text-white">Usuario</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary rounded-start">👤</span>
                    <input asp-for="Usuario" class="form-control form-control-lg login-input rounded-end" placeholder="Usuario o email" autocomplete="username" />
                </div>
                <span asp-validation-for="Usuario" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label text-white">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary rounded-start">🔒</span>
                    <input asp-for="Password" type="password" class="form-control form-control-lg login-input rounded-end" placeholder="Contraseña" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Recordarme" class="form-check-input bg-dark border-secondary" id="recordarme" />
                <label class="form-check-label text-white" for="recordarme">Recordarme</label>
            </div>

            <button type="submit" class="btn btn-primary login-btn w-100 rounded-pill mb-3">Entrar</button>

            <div class="text-center">
                <a asp-controller="Auth" asp-action="ForgotPassword" class="link-accent small">¿Olvidaste tu contraseña?</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
