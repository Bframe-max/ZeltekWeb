@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="login-card card border-0 shadow">
    <div class="card-body p-4 p-sm-5 text-center">
        <div class="display-4 mb-3">🔐</div>
        <h2 class="h5 fw-bold text-slate-800 mb-3">Restablecer contraseña</h2>
        <p class="text-secondary mb-4">
            Para restablecer tu contraseña, por favor contacta al Administrador de Sistemas de Zeltek.
        </p>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary login-btn rounded-pill px-4">Volver al Login</a>
    </div>
</div>
