@model ZeltekWeb.Models.GastoCreateViewModel

@{
    ViewData["Title"] = "Nuevo Gasto";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card bg-card border-0 shadow-lg mt-4">
            <div class="card-header bg-transparent border-bottom border-secondary py-3">
                <h4 class="text-white fw-bold mb-0">➕ Agregar Gasto Operativo</h4>
            </div>
            <div class="card-body p-4">

                <form asp-action="Create" method="post">

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FechaGasto" class="form-label text-secondary small fw-bold"></label>
                            <input asp-for="FechaGasto" type="date" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="FechaGasto" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Monto" class="form-label text-secondary small fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">$</span>
                                <input asp-for="Monto" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Monto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label text-secondary small fw-bold"></label>
                        <input asp-for="Descripcion" class="form-control bg-dark text-white border-secondary" placeholder="Ej: Envío DHL, Pago luz..." />
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoriaGasto" class="form-label text-secondary small fw-bold"></label>
                        <select asp-for="CategoriaGasto" class="form-select bg-dark text-white border-secondary">
                            <option value="">-- Seleccionar categoría --</option>
                            @foreach (var c in ViewBag.Categorias as string[] ?? Array.Empty<string>())
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                        <span asp-validation-for="CategoriaGasto" class="text-danger small"></span>
                    </div>

                    <hr class="border-secondary my-4" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger fw-bold py-2 px-4">
                            <i class="bi bi-check-lg me-2"></i>Guardar Gasto
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
