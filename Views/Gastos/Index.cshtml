@model List<ZeltekWeb.Models.GastoListViewModel>

@{
    ViewData["Title"] = "Gastos Operativos";
    var resumen = ViewBag.Resumen as ZeltekWeb.Models.GastosResumenViewModel;
    var porCategoria = ViewBag.GastosPorCategoria as List<ZeltekWeb.Models.GastoPorCategoriaViewModel> ?? new List<ZeltekWeb.Models.GastoPorCategoriaViewModel>();
    var desde = ViewBag.Desde as DateTime?;
    var hasta = ViewBag.Hasta as DateTime?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-slate-800">🧾 Gastos Operativos</h2>
    <a asp-action="Create" class="btn btn-danger fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Nuevo Gasto
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-card border-start border-4 border-danger">
            <div class="card-body">
                <small class="text-secondary text-uppercase fw-bold">Total Gastos</small>
                <h3 class="text-danger fw-bold mb-0">$@(resumen?.TotalGastos.ToString("N2") ?? "0.00")</h3>
                <small class="text-secondary">En el período</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-card border-start border-4 border-secondary">
            <div class="card-body">
                <small class="text-secondary text-uppercase fw-bold">Cantidad</small>
                <h3 class="text-slate-800 fw-bold mb-0">@(resumen?.CantidadGastos ?? 0)</h3>
                <small class="text-secondary">Registros</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-card border-0">
            <div class="card-body py-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col">
                        <label class="form-label text-secondary small mb-0">Desde</label>
                        <input type="date" name="desde" class="form-control form-control-sm bg-dark text-slate-800 border-secondary"
                               value="@(desde?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col">
                        <label class="form-label text-secondary small mb-0">Hasta</label>
                        <input type="date" name="hasta" class="form-control form-control-sm bg-dark text-slate-800 border-secondary"
                               value="@(hasta?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-sm w-100 text-nowrap px-3">Filtrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card bg-card border-0">
            <div class="card-header bg-transparent border-bottom border-secondary py-3">
                <h5 class="text-slate-800 fw-bold mb-0">📊 ¿En qué se gasta más?</h5>
                <small class="text-secondary">Por categoría (período filtrado)</small>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="chartGastosCategoria" height="220"></canvas>
            </div>
            @if (porCategoria.Count == 0)
            {
                <div class="text-center py-4 text-secondary small">No hay gastos en el período.</div>
            }
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card bg-card border-0">
            <div class="card-header bg-transparent border-bottom border-secondary py-3">
                <h5 class="text-slate-800 fw-bold mb-0">Listado de gastos</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="border-bottom: 1px solid var(--border-color);">
                        <tr>
                            <th class="ps-4 text-slate-800">Fecha</th>
                            <th class="text-slate-800">Descripción</th>
                            <th class="text-slate-800">Categoría</th>
                            <th class="text-end pe-4 text-slate-800">Monto</th>
                            <th class="text-end pe-4 text-slate-800">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">@g.FechaGasto.ToString("dd/MM/yyyy")</td>
                                <td class="text-slate-800">@g.Descripcion</td>
                                <td>
                                    <span class="badge bg-dark text-info border border-info border-opacity-25">@(g.CategoriaGasto ?? "—")</span>
                                </td>
                                <td class="text-end text-danger fw-bold">$@g.Monto.ToString("N2")</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@g.GastoID" class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@g.GastoID" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este gasto?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Count == 0)
            {
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-receipt fs-1 d-block mb-2"></i>
                    No hay gastos en el período seleccionado.
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(porCategoria.Select(x => new { x.Categoria, x.Total })));
        const ctx = document.getElementById('chartGastosCategoria')?.getContext('2d');
        if (ctx && data.length > 0) {
            const colores = ['#6366f1', '#0ea5e9', '#10b981', '#f59e0b', '#f43f5e', '#8b5cf6', '#d946ef', '#94a3b8'];
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: data.map(x => x.Categoria),
                    datasets: [{
                        data: data.map(x => x.Total),
                        backgroundColor: colores.slice(0, data.length),
                        borderWidth: 2,
                        borderColor: zc().surface
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'right', labels: { color: zc().text, padding: 10 } },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    const t = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                    const p = ((ctx.raw / t) * 100).toFixed(1);
                                    return ctx.label + ': $' + ctx.raw.toLocaleString() + ' (' + p + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }
    })();
</script>
