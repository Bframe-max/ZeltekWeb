@model ZeltekWeb.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Operativo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-white mb-0">⚡ Zeltek Dashboard</h2>
        <p class="text-secondary small mb-0">Resumen de Activos y Operaciones</p>
    </div>
    <div>
        <span class="badge bg-dark border border-secondary text-secondary p-2">
            Total Activos (Prod + Deuda): <span class="text-white fw-bold">$@Model.TotalActivos.ToString("N2")</span>
        </span>
    </div>
</div>

<div class="row g-3">

    <div class="col-md-4">
        <div class="card h-100 border-start border-4 border-primary bg-card hover-card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-3 text-primary me-3">📦</div>
                    <div>
                        <h6 class="text-secondary text-uppercase small fw-bold mb-0">En Bodega</h6>
                        <small class="text-muted" style="font-size: 0.7rem;">Mercadería lista</small>
                    </div>
                </div>
                <h3 class="fw-bold text-white mb-0">$@Model.ValorInventario.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-start border-4 border-info bg-card hover-card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-3 text-info me-3">✈️</div>
                    <div>
                        <h6 class="text-secondary text-uppercase small fw-bold mb-0">En Tránsito</h6>
                        <small class="text-muted" style="font-size: 0.7rem;">Compras eBay</small>
                    </div>
                </div>
                <h3 class="fw-bold text-white mb-0">$@Model.EnCamino.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-start border-4 border-danger bg-card hover-card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-3 text-danger me-3">📝</div>
                    <div>
                        <h6 class="text-secondary text-uppercase small fw-bold mb-0">Por Cobrar</h6>
                        <small class="text-muted" style="font-size: 0.7rem;">Dinero en la calle</small>
                    </div>
                </div>
                <h3 class="fw-bold text-white mb-0">$@Model.PorCobrar.ToString("N2")</h3>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card bg-card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">

                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-circle bg-success bg-opacity-10 me-3">
                        <i class="bi bi-graph-up-arrow text-success fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-white fw-bold mb-0">Rendimiento Total</h6>
                        <small class="text-secondary">Ganancia Acumulada</small>
                    </div>
                </div>

                <div class="text-end">
                    <h4 class="text-success fw-bold mb-0">+$@Model.GananciaTotal.ToString("N2")</h4>
                    <small class="text-muted">En @Model.CantidadVendidos ventas realizadas</small>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.2s;
    }

        .hover-card:hover {
            transform: translateY(-3px);
            background-color: #232333 !important;
        }
</style>