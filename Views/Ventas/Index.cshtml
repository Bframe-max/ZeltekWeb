@model List<ZeltekWeb.Models.VentaListViewModel>

@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-white">📈 Reporte de Ventas</h2>
</div>

<div class="row mb-4 g-3">

    <div class="col-md-4">
        <div class="card bg-dark border-secondary text-white shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-secondary text-uppercase mb-1 small fw-bold">Total Facturado</h6>
                    <h2 class="fw-bold text-white mb-0">$@ViewBag.TotalVendido.ToString("N0")</h2>
                </div>
                <div class="fs-1 text-primary"><i class="bi bi-cash-stack"></i></div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-dark border-success text-white shadow-sm h-100" style="border-left: 5px solid #198754;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-success text-uppercase mb-1 small fw-bold">Ganancia Bruta</h6>
                    <h2 class="fw-bold text-success mb-0">$@ViewBag.TotalGanancia.ToString("N0")</h2>
                    <small class="text-secondary" style="font-size: 0.7rem;">(Venta - Costos Directos)</small>
                </div>
                <div class="fs-1 text-success"><i class="bi bi-graph-up-arrow"></i></div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-dark border-info text-white shadow-sm h-100" style="border-left: 5px solid #0dcaf0;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-info text-uppercase mb-1 small fw-bold">Equipos Vendidos</h6>
                    <h2 class="fw-bold text-info mb-0">@ViewBag.TotalEquipos</h2>
                    <small class="text-secondary" style="font-size: 0.7rem;">Unidades en este periodo</small>
                </div>
                <div class="fs-1 text-info"><i class="bi bi-box-seam"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card bg-card border-0 mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="text-secondary small fw-bold">Buscar</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary">🔍</span>
                    <input type="text" name="buscar" class="form-control bg-dark text-white border-secondary"
                           placeholder="Cliente, Serie, Producto..." value="@ViewData["Busqueda"]">
                </div>
            </div>
            <div class="col-md-3">
                <label class="text-secondary small fw-bold">Desde</label>
                <input type="date" name="fechaInicio" class="form-control bg-dark text-white border-secondary"
                       value="@ViewData["FechaInicio"]">
            </div>
            <div class="col-md-3">
                <label class="text-secondary small fw-bold">Hasta</label>
                <input type="date" name="fechaFin" class="form-control bg-dark text-white border-secondary"
                       value="@ViewData["FechaFin"]">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card bg-card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="border-bottom: 1px solid #373b3e;">
                <tr>
                    <th class="ps-4 text-white">Fecha / ID</th>
                    <th class="text-white">Cliente</th>
                    <th class="text-white">Producto Vendido</th>
                    <th class="text-end text-secondary">Costo Real</th>
                    <th class="text-end text-white">Venta</th>
                    <th class="text-end text-white pe-4">Ganancia Bruta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="text-white fw-bold">@v.FechaVenta.ToString("dd/MM/yyyy")</div>
                            <small class="text-secondary font-monospace">#@v.VentaID</small>
                        </td>

                        <td>
                            <div class="d-flex flex-column">
                                <span class="text-white">@v.Cliente</span>
                                @if (v.TipoCliente == "Revendedor")
                                {
                                    <span class="badge bg-warning text-dark border border-warning mt-1" style="width: fit-content; font-size: 0.65rem;">
                                        🤝 Revendedor
                                    </span>
                                }
                                else
                                {
                                    <small class="text-secondary" style="font-size: 0.75rem;">👤 Público</small>
                                }
                            </div>
                        </td>

                        <td>
                            <div class="d-flex flex-column">
                                <span class="text-info fw-bold">@v.Producto</span>
                                <small class="text-secondary" style="font-size: 0.75rem;">@v.Especificaciones</small>
                                <small class="text-secondary font-monospace" style="font-size: 0.7rem;">S/N: @v.NumeroSerie</small>
                            </div>
                        </td>

                        <td class="text-end text-secondary">
                            $@v.CostoTotalVenta.ToString("N2")
                        </td>

                        <td class="text-end text-white fw-bold">
                            $@v.VentaTotal.ToString("N2")
                        </td>

                        <td class="text-end pe-4">
                            @if (v.Ganancia > 0)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 fs-6">
                                    +$@v.Ganancia.ToString("N2")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25">
                                    $@v.Ganancia.ToString("N2")
                                </span>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center py-5 text-secondary">No hay ventas registradas en este periodo.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>