@model ZeltekWeb.Models.ReporteIndexViewModel

@{
    ViewData["Title"] = "Reportes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-white">📊 Reportes</h2>
    <div class="d-flex gap-2 align-items-center">
        <span class="text-secondary small">Tendencia:</span>
        <a asp-action="Index" asp-route-meses="6" asp-route-periodoGanancia="@Model.PeriodoGananciaMeses" class="btn btn-sm @(Model.MesesTendencia == 6 ? "btn-primary" : "btn-outline-secondary")">6 meses</a>
        <a asp-action="Index" asp-route-meses="12" asp-route-periodoGanancia="@Model.PeriodoGananciaMeses" class="btn btn-sm @(Model.MesesTendencia == 12 ? "btn-primary" : "btn-outline-secondary")">12 meses</a>
    </div>
</div>

<!-- Ganancia Neta (Ventas - Gastos = Ganancia Neta) -->
<!-- Ganancia Neta (Bento Grid) -->
<div class="mb-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-4">
        <div>
            <h5 class="text-white font-bold text-xl flex items-center gap-2">
                📊 Ganancia Neta
                <span class="text-xs font-normal text-gray-500 bg-gray-800 px-2 py-1 rounded-full border border-gray-700">Últimos @Model.PeriodoGananciaMeses meses</span>
            </h5>
             <p class="text-gray-400 text-sm mt-1">Tu rentabilidad real (Ventas − Gastos).</p>
        </div>
        <div class="flex gap-2 mt-2 md:mt-0">
             <a asp-action="Index" asp-route-meses="@Model.MesesTendencia" asp-route-periodoGanancia="1" 
               class="px-3 py-1 text-sm rounded-lg border transition-colors @(Model.PeriodoGananciaMeses == 1 ? "bg-blue-600 border-blue-500 text-white" : "border-gray-700 text-gray-400 hover:bg-gray-800")">1 mes</a>
             <a asp-action="Index" asp-route-meses="@Model.MesesTendencia" asp-route-periodoGanancia="3" 
               class="px-3 py-1 text-sm rounded-lg border transition-colors @(Model.PeriodoGananciaMeses == 3 ? "bg-blue-600 border-blue-500 text-white" : "border-gray-700 text-gray-400 hover:bg-gray-800")">3 meses</a>
             <a asp-action="Index" asp-route-meses="@Model.MesesTendencia" asp-route-periodoGanancia="12" 
               class="px-3 py-1 text-sm rounded-lg border transition-colors @(Model.PeriodoGananciaMeses == 12 ? "bg-blue-600 border-blue-500 text-white" : "border-gray-700 text-gray-400 hover:bg-gray-800")">12 meses</a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1: Ganancia Bruta -->
        <div class="group relative overflow-hidden rounded-[30px] bg-[#24253b] border border-white/5 shadow-2xl transition-all duration-300 hover:scale-[1.02] hover:shadow-blue-500/10">
            <div class="absolute inset-0 bg-gradient-to-br from-gray-900/50 to-gray-800/50 opacity-50 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative p-6">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 bg-blue-500/10 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                     <!-- Decorative Sparkline -->
                     <svg class="w-16 h-8 text-blue-500/20" viewBox="0 0 100 40" fill="none" stroke="currentColor" stroke-width="3">
                        <path d="M0 35 Q10 15 20 25 T40 15 T60 25 T80 10 T100 20" />
                     </svg>
                </div>
                <p class="text-sm font-medium text-gray-400 uppercase tracking-wide">Ingresos Totales (Ventas)</p>
                <h3 class="text-3xl font-bold text-white mt-1 group-hover:text-blue-400 transition-colors">$@Model.IngresoTotal.ToString("N2")</h3>
                <div class="mt-4 flex items-center gap-1 text-xs text-blue-400 bg-blue-500/5 px-2 py-1 rounded-full w-fit">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    <span>Ingreso Total</span>
                </div>
            </div>
        </div>

        <!-- Card 2: Gastos Operativos -->
        <div class="group relative overflow-hidden rounded-[30px] bg-[#24253b] border border-white/5 shadow-2xl transition-all duration-300 hover:scale-[1.02] hover:shadow-red-500/10">
            <div class="absolute inset-0 bg-gradient-to-br from-gray-900/50 to-gray-800/50 opacity-50 group-hover:opacity-100 transition-opacity"></div>
             <!-- Background Texture -->
            <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-red-500/5 rounded-full blur-2xl group-hover:bg-red-500/10 transition-all"></div>

            <div class="relative p-6">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 bg-red-500/10 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline><polyline points="17 18 23 18 23 12"></polyline></svg>
                    </div>
                </div>
                <p class="text-sm font-medium text-gray-400 uppercase tracking-wide">Gastos Operativos</p>
                <h3 class="text-3xl font-bold text-white mt-1 group-hover:text-red-400 transition-colors">− $@Model.TotalGastosOperativos.ToString("N2")</h3>
                 <div class="mt-4 flex items-center gap-1 text-xs text-red-400 bg-red-500/5 px-2 py-1 rounded-full w-fit">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path></svg>
                    <span>Salida Total</span>
                </div>
            </div>
        </div>

        <!-- Card 3: Ganancia Neta -->
        <div class="group relative overflow-hidden rounded-[30px] bg-[#24253b] border border-white/5 shadow-2xl transition-all duration-300 hover:scale-[1.02] hover:shadow-emerald-500/10">
            <div class="absolute inset-0 bg-gradient-to-br from-gray-900/50 to-gray-800/50 opacity-50 group-hover:opacity-100 transition-opacity"></div>
             <div class="absolute -right-6 -top-6 w-24 h-24 bg-emerald-500/5 rounded-full blur-2xl group-hover:bg-emerald-500/10 transition-all"></div>

            <div class="relative p-6">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 bg-emerald-500/10 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V8H6a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h2"></path><path d="M16 12v3.98A2 2 0 0 1 14 18H2.97"></path><path d="M11 12H8a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"></path></svg>
                    </div>
                     <!-- Decorative Sparkline -->
                     <svg class="w-16 h-8 text-emerald-500/20" viewBox="0 0 100 40" fill="none" stroke="currentColor" stroke-width="3">
                        <path d="M0 30 Q20 30 30 20 T60 20 T90 10" />
                     </svg>
                </div>
                <p class="text-sm font-medium text-gray-400 uppercase tracking-wide">Ganancia Neta (Limpia)</p>
                <h3 class="text-3xl font-bold @(Model.GananciaNeta >= 0 ? "text-emerald-400" : "text-red-400") mt-1">$@Model.GananciaNeta.ToString("N2")</h3>
                <div class="mt-4 flex items-center gap-1 text-xs text-emerald-400 bg-emerald-500/5 px-2 py-1 rounded-full w-fit">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>En el bolsillo</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Valor del Inventario Actual -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card bg-card border-0 border-start border-4 border-success">
            <div class="card-body py-4">
                <small class="text-secondary text-uppercase fw-bold">💰 Valor del Inventario Actual</small>
                <p class="text-secondary small mb-0">Dinero que tienes parado en bodega (costo real)</p>
                <h1 class="text-success fw-bold mb-0 display-4">$@Model.ValorInventarioActual.ToString("N2")</h1>
            </div>
        </div>
    </div>
</div>

<!-- Tendencia de Crecimiento -->
<div class="card bg-card border-0 mb-4">
    <div class="card-header bg-transparent border-bottom border-secondary py-3">
        <h5 class="text-white fw-bold mb-0">📈 Tendencia de Crecimiento</h5>
        <small class="text-secondary">¿Estoy creciendo o cayendo respecto al mes pasado? Últimos @Model.MesesTendencia meses.</small>
    </div>
    <div class="card-body">
        <canvas id="chartTendencia" height="120"></canvas>
    </div>
</div>

<!-- 3. Top Productos -->
<div class="card bg-card border-0 mb-4">
    <div class="card-header bg-transparent border-bottom border-secondary py-3">
        <h5 class="text-white fw-bold mb-0">🏆 Top Productos (Qué comprar en eBay)</h5>
        <small class="text-secondary">Invierte donde hay retorno rápido. Los que más vendes.</small>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="border-bottom: 1px solid var(--border-color);">
                            <tr>
                                <th class="text-white">Producto</th>
                                <th class="text-end text-white">Ventas</th>
                                <th class="text-end text-white">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.TopProductos.Take(10))
                            {
                                <tr>
                                    <td class="fw-bold text-white">@t.ProductoNombre</td>
                                    <td class="text-end text-info">@t.CantidadVentas</td>
                                    <td class="text-end text-success">$@t.TotalVendido.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.TopProductos.Count == 0)
                {
                    <p class="text-secondary mb-0">Aún no hay ventas para mostrar.</p>
                }
            </div>
            <div class="col-md-6 d-flex align-items-center justify-content-center">
                <canvas id="chartTopProductos" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- 3.5 Top Clientes Revendedores (vw_TopClientes) -->
<div class="card bg-card border-0 mb-4">
    <div class="card-header bg-transparent border-bottom border-secondary py-3">
        <h5 class="text-white fw-bold mb-0">🤝 Top Clientes Revendedores</h5>
        <small class="text-secondary">Quién más compra: desde vw_TopClientes (TipoCliente = Revendedor).</small>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="border-bottom: 1px solid var(--border-color);">
                    <tr>
                        <th class="ps-4 text-white">#</th>
                        <th class="text-white">Cliente</th>
                        <th class="text-center text-white">Compras</th>
                        <th class="text-end text-white">Total comprado</th>
                        <th class="text-end text-white">Ganancia generada</th>
                        <th class="text-end pe-4 text-white">Última compra</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int pos = 1; }
                    @foreach (var r in Model.TopRevendedores.Take(10))
                    {
                        <tr>
                            <td class="ps-4 text-secondary">@pos</td>
                            <td class="fw-bold text-white">@r.NombreCliente</td>
                            <td class="text-center text-info">@r.CantidadCompras</td>
                            <td class="text-end text-success fw-bold">$@r.TotalComprado.ToString("N2")</td>
                            <td class="text-end text-success">$@r.GananciaGenerada.ToString("N2")</td>
                            <td class="text-end pe-4 text-secondary">@(r.UltimaCompra?.ToString("dd/MM/yyyy") ?? "—")</td>
                        </tr>
                        pos++;
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TopRevendedores.Count == 0)
        {
            <p class="text-secondary mb-0">No hay clientes revendedores con ventas. Revisa que en vw_ReporteVentas existan ventas con TipoCliente = 'Revendedor'.</p>
        }
    </div>
</div>

<!-- 4. Alerta Inventario Dormido -->
<div class="card bg-card border-0 border-top border-4 border-danger">
    <div class="card-header bg-transparent border-bottom border-secondary py-3">
        <h5 class="text-white fw-bold mb-0">🐢 Alerta de Inventario Dormido (Aging)</h5>
        <small class="text-secondary">Productos +60 días en stock. Bájales el precio o sácalos ya.</small>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="border-bottom: 1px solid var(--border-color);">
                    <tr>
                        <th class="ps-4 text-white">Producto / Serie</th>
                        <th class="text-center text-white">Días en stock</th>
                        <th class="text-end text-white">Costo</th>
                        <th class="text-end text-white">Precio venta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.InventarioDormido)
                    {
                        <tr class="table-danger bg-danger bg-opacity-10">
                            <td class="ps-4">
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-white">@d.ProductoNombre</span>
                                    <small class="text-secondary font-monospace" style="font-size: 0.75rem;">Serie: @(string.IsNullOrEmpty(d.NumeroSerie) ? "—" : d.NumeroSerie)</small>
                                    @if (!string.IsNullOrEmpty(d.Procesador) || d.RAM_GB > 0 || d.Almacenamiento_GB > 0)
                                    {
                                        <small class="text-secondary" style="font-size: 0.7rem;">
                                            @if (!string.IsNullOrEmpty(d.Procesador)) { <span>@d.Procesador</span> }
                                            @if (d.RAM_GB > 0) { <span> • @d.RAM_GB GB RAM</span> }
                                            @if (d.Almacenamiento_GB > 0) { <span> • @d.Almacenamiento_GB GB</span> }
                                        </small>
                                    }
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-3">@d.DiasEnStock días</span>
                            </td>
                            <td class="text-end text-secondary">$@d.CostoTotal.ToString("N2")</td>
                            <td class="text-end fw-bold text-white">$@d.PrecioVenta.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.InventarioDormido.Count == 0)
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
                No hay ítems con más de 60 días en stock.
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        const coloresBarras = ['#5646ff', '#0dcaf0', '#198754', '#ffc107', '#fd7e14', '#6f42c1', '#20c997', '#e83e8c'];
        const coloresPie = ['#5646ff', '#0dcaf0', '#198754', '#ffc107', '#fd7e14', '#6f42c1', '#20c997', '#e83e8c', '#6c757d', '#212529'];

        // Gráfico de tendencia: doble eje (barras = Total Facturado $, línea = Equipos Vendidos)
        const tendencia = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TendenciaMeses.Select(x => new { x.MesLabel, x.TotalVentas, x.CantidadEquipos })));
        const ctxTendencia = document.getElementById('chartTendencia')?.getContext('2d');
        if (ctxTendencia && tendencia.length) {
            new Chart(ctxTendencia, {
                type: 'bar',
                data: {
                    labels: tendencia.map(x => x.MesLabel),
                    datasets: [
                        {
                            label: 'Total Facturado ($)',
                            data: tendencia.map(x => x.TotalVentas),
                            backgroundColor: 'rgba(86, 70, 255, 0.7)',
                            borderColor: '#5646ff',
                            borderWidth: 1,
                            borderRadius: 6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Equipos Vendidos',
                            type: 'line',
                            data: tendencia.map(x => x.CantidadEquipos),
                            borderColor: '#FF5733',
                            backgroundColor: 'rgba(255, 87, 51, 0.1)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.2,
                            pointRadius: 4,
                            pointBackgroundColor: '#FF5733',
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: { color: '#fff', usePointStyle: true }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    if (ctx.dataset.yAxisID === 'y')
                                        return ctx.dataset.label + ': $' + ctx.parsed.y.toLocaleString();
                                    return ctx.dataset.label + ': ' + ctx.parsed.y + ' equipos';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            beginAtZero: true,
                            grid: { color: 'rgba(255,255,255,0.06)' },
                            ticks: { color: '#92929f', callback: v => '$' + v.toLocaleString() }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            beginAtZero: true,
                            min: 0,
                            ticks: {
                                color: '#FF5733',
                                stepSize: 1,
                                callback: v => Number.isInteger(v) ? v : ''
                            },
                            grid: { drawOnChartArea: false }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#92929f' }
                        }
                    }
                }
            });
        }

        // Gráfico de pastel Top Productos (solo top 8)
        const topProductos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProductos.Take(8).Select(x => new { x.ProductoNombre, x.CantidadVentas })));
        const ctxPie = document.getElementById('chartTopProductos')?.getContext('2d');
        if (ctxPie && topProductos.length) {
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: topProductos.map(x => x.ProductoNombre),
                    datasets: [{
                        data: topProductos.map(x => x.CantidadVentas),
                        backgroundColor: coloresPie.slice(0, topProductos.length),
                        borderWidth: 2,
                        borderColor: '#1e1e2d'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'right', labels: { color: '#fff', padding: 12 } },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    const t = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                    const p = ((ctx.raw / t) * 100).toFixed(1);
                                    return ctx.label + ': ' + ctx.raw + ' ventas (' + p + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }
    })();
</script>

<style>
    .table-danger.bg-danger.bg-opacity-10 { background-color: rgba(220, 53, 69, 0.08) !important; }
</style>
